---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { getEntryDate, isPublishedEntry, sortByPubDateDesc } from '../../utils/content';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts
  .filter(isPublishedEntry)
  .sort(sortByPubDateDesc);

const groups = Array.from(
  sortedPosts.reduce((map, post) => {
    const year = getEntryDate(post)?.getFullYear();
    if (!year) return map;
    const entries = map.get(year) || [];
    entries.push(post);
    map.set(year, entries);
    return map;
  }, new Map())
).sort(([a], [b]) => b - a);

const featuredPost = sortedPosts[0];

const imageFor = (entry) => {
  const image = entry?.data?.heroImage || entry?.data?.image;
  if (!image) return '';
  if (typeof image === 'string') return image;
  if (typeof image === 'object' && 'src' in image) return image.src;
  return '';
};

const excerptFor = (entry) => {
  const source = entry?.data?.description || entry?.body || '';
  return source
    .replace(/<br\s*\/?>/gi, ' ')
    .replace(/[#*_>`-]/g, '')
    .replace(/\s+/g, ' ')
    .trim()
    .slice(0, 108);
};
---

<BaseLayout title="文章">
  <section class="page-shell">
    <header class="page-hero">
      <p class="font-serif-cn text-sm tracking-[0.28em] text-zinc-500 dark:text-zinc-500">用文字探寻思维的边界。</p>
      <h1 class="page-title mt-9">文章</h1>
      <div class="mx-auto mt-5 h-px w-12 bg-teal-600 dark:bg-teal-300"></div>
      <p class="page-subtitle">
        这里保留随笔、评论和关于存在与意义的观察。
      </p>
      <p class="mt-8 text-sm text-zinc-500 dark:text-zinc-500">
        当前收录 <span class="font-serif-cn text-2xl font-semibold text-zinc-950 dark:text-zinc-50">{sortedPosts.length}</span> 篇
      </p>
    </header>

    {sortedPosts.length === 0 ? (
      <div class="mx-auto mt-14 max-w-2xl border-y border-zinc-200/80 py-10 text-center dark:border-zinc-800">
        <p class="font-serif-cn text-3xl font-semibold text-zinc-950 dark:text-zinc-50">文章正在整理</p>
        <p class="mx-auto mt-5 max-w-lg text-sm leading-8 text-zinc-600 dark:text-zinc-400">
          当前内容仓库里还没有正式博客文章。
        </p>
      </div>
    ) : (
      <>
        {featuredPost && (
          <article class="grid gap-10 border-b border-zinc-200/80 py-14 dark:border-zinc-800 lg:grid-cols-[0.82fr_1fr] lg:items-center">
            {imageFor(featuredPost) && (
              <a href={`/blog/${featuredPost.slug}/`} class="block overflow-hidden border border-zinc-200/80 bg-zinc-100 dark:border-zinc-800 dark:bg-zinc-900">
                <img
                  src={imageFor(featuredPost)}
                  alt={featuredPost.data.title}
                  class="aspect-[4/3] h-full w-full object-cover transition duration-700 hover:scale-[1.02]"
                  loading="eager"
                />
              </a>
            )}
            <div class={!imageFor(featuredPost) ? 'mx-auto max-w-3xl text-center lg:col-span-2' : ''}>
              <p class="editorial-kicker">Latest</p>
              <h2 class="mt-5 font-serif-cn text-4xl font-semibold leading-tight tracking-[0.04em] text-zinc-950 dark:text-zinc-50 sm:text-5xl">
                <a href={`/blog/${featuredPost.slug}/`} class="transition-colors hover:text-teal-700 dark:hover:text-teal-300">
                  {featuredPost.data.title}
                </a>
              </h2>
              <p class={`mt-6 text-sm leading-8 text-zinc-600 dark:text-zinc-400 ${!imageFor(featuredPost) ? 'mx-auto max-w-2xl' : 'max-w-2xl'}`}>
                {excerptFor(featuredPost) || '这篇文章正在整理摘要。'}
              </p>
              <div class={`mt-7 flex flex-wrap gap-4 text-sm text-zinc-500 dark:text-zinc-500 ${!imageFor(featuredPost) ? 'justify-center' : ''}`}>
                <time datetime={featuredPost.data.pubDate.toISOString()}>
                  <FormattedDate date={featuredPost.data.pubDate} />
                </time>
                {featuredPost.data.readingTime && <span>{featuredPost.data.readingTime}</span>}
                {featuredPost.data.tags?.slice(0, 3).map(tag => (
                  <a href={`/tags/${tag}`} class="paper-link">#{tag}</a>
                ))}
              </div>
            </div>
          </article>
        )}

        <div class="grid gap-12 pt-14 lg:grid-cols-[12rem_1fr]">
          <aside class="lg:sticky lg:top-28 lg:self-start">
            <p class="mb-4 text-xs font-semibold uppercase tracking-[0.24em] text-zinc-500 dark:text-zinc-500">Year</p>
            <nav class="flex gap-3 overflow-x-auto pb-2 lg:flex-col lg:overflow-visible lg:pb-0" data-year-nav>
              {groups.map(([year, posts]) => (
                <a
                  href={`#year-${year}`}
                  class="flex min-w-fit items-center justify-between gap-5 border-b border-zinc-200/80 px-1 py-3 text-sm text-zinc-600 transition-colors hover:text-teal-700 dark:border-zinc-800 dark:text-zinc-400 dark:hover:text-teal-300 lg:w-full"
                >
                  <span class="font-semibold text-zinc-900 dark:text-zinc-100">{year}</span>
                  <span>{posts.length} 篇</span>
                </a>
              ))}
            </nav>
          </aside>

          <div>
            {groups.map(([year, posts]) => (
              <section id={`year-${year}`} class="scroll-mt-28 pb-14">
                <h2 class="mb-5 border-b border-zinc-200/80 pb-3 font-serif-cn text-2xl font-semibold tracking-[0.08em] text-zinc-950 dark:border-zinc-800 dark:text-zinc-50">
                  {year}
                </h2>
                <div class="divide-y divide-zinc-200/80 dark:divide-zinc-800">
                  {posts.map(post => (
                    <article class={`grid gap-5 py-7 ${imageFor(post) ? 'sm:grid-cols-[8rem_1fr]' : 'sm:grid-cols-[7rem_1fr]'}`}>
                      {imageFor(post) ? (
                        <a href={`/blog/${post.slug}/`} class="overflow-hidden border border-zinc-200/80 bg-zinc-100 dark:border-zinc-800 dark:bg-zinc-900">
                          <img src={imageFor(post)} alt={post.data.title} class="aspect-[4/3] w-full object-cover transition duration-500 hover:scale-[1.02]" loading="lazy" />
                        </a>
                      ) : (
                        <time datetime={post.data.pubDate.toISOString()} class="text-xs uppercase tracking-[0.2em] text-zinc-500 dark:text-zinc-500">
                          <FormattedDate date={post.data.pubDate} />
                        </time>
                      )}
                      <div>
                        {imageFor(post) && (
                          <time datetime={post.data.pubDate.toISOString()} class="text-xs uppercase tracking-[0.2em] text-zinc-500 dark:text-zinc-500">
                            <FormattedDate date={post.data.pubDate} />
                          </time>
                        )}
                        <h3 class="mt-2 font-serif-cn text-2xl font-semibold text-zinc-950 dark:text-zinc-50">
                          <a href={`/blog/${post.slug}/`} class="transition-colors hover:text-teal-700 dark:hover:text-teal-300">
                            {post.data.title}
                          </a>
                        </h3>
                        <p class="mt-3 line-clamp-2 text-sm leading-7 text-zinc-600 dark:text-zinc-400">
                          {excerptFor(post) || '这篇文章正在整理摘要。'}
                        </p>
                      </div>
                    </article>
                  ))}
                </div>
              </section>
            ))}
          </div>
        </div>
      </>
    )}
  </section>
</BaseLayout>

<script>
  (() => {
    const setupYearNavigation = () => {
      document.querySelectorAll('[data-year-nav] a[href^="#year-"]').forEach((link) => {
        if (!(link instanceof HTMLAnchorElement) || link.dataset.yearHandled === 'true') return;

        link.dataset.yearHandled = 'true';
        link.addEventListener('click', (event) => {
          const id = link.hash.slice(1);
          const target = id ? document.getElementById(id) : null;
          if (!target) return;

          event.preventDefault();
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          window.history.pushState(null, '', link.hash);
        });
      });

      if (window.location.hash.startsWith('#year-')) {
        const target = document.getElementById(window.location.hash.slice(1));
        if (target) {
          window.setTimeout(() => {
            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }, 80);
        }
      }
    };

    setupYearNavigation();
    document.addEventListener('DOMContentLoaded', setupYearNavigation);
    document.addEventListener('spa-content-loaded', setupYearNavigation);
  })();
</script>
