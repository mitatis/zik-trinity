---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { getEntryDate, isPublishedEntry, sortByPubDateDesc } from '../../utils/content';

const allPoems = await getCollection('poetry');
const sortedPoems = allPoems
  .filter(isPublishedEntry)
  .sort(sortByPubDateDesc);

const groups = Array.from(
  sortedPoems.reduce((map, poem) => {
    const year = getEntryDate(poem)?.getFullYear();
    if (!year) return map;
    const entries = map.get(year) || [];
    entries.push(poem);
    map.set(year, entries);
    return map;
  }, new Map())
).sort(([a], [b]) => b - a);

const excerptFor = (entry) => {
  const source = entry?.data?.description || entry?.body || '';
  return source
    .replace(/<br\s*\/?>/gi, ' ')
    .replace(/[#*_>`-]/g, '')
    .replace(/\s+/g, ' ')
    .trim()
    .slice(0, 72);
};
---

<BaseLayout title="散诗集">
  <section class="page-shell">
    <header class="page-hero">
      <p class="font-serif-cn text-sm tracking-[0.28em] text-zinc-500 dark:text-zinc-500">在语言的缝隙里停留，在诗的倒影里认识自我。</p>
      <h1 class="page-title mt-9">散诗集</h1>
      <div class="mx-auto mt-5 h-px w-12 bg-teal-600 dark:bg-teal-300"></div>
      <p class="page-subtitle">
        这里保留更慢的文本，让句子停在它该停的位置。
      </p>
      <p class="mt-8 text-sm text-zinc-500 dark:text-zinc-500">
        当前收录 <span class="font-serif-cn text-2xl font-semibold text-zinc-950 dark:text-zinc-50">{sortedPoems.length}</span> 首
      </p>
    </header>

    <div class="grid gap-12 pt-14 lg:grid-cols-[12rem_1fr]">
      <aside class="lg:sticky lg:top-28 lg:self-start">
        <p class="mb-4 text-xs font-semibold uppercase tracking-[0.24em] text-zinc-500 dark:text-zinc-500">Year</p>
        <nav class="flex gap-3 overflow-x-auto pb-2 lg:flex-col lg:overflow-visible lg:pb-0" data-year-nav>
          {groups.map(([year, poems]) => (
            <a
              href={`#year-${year}`}
              class="flex min-w-fit items-center justify-between gap-5 border-b border-zinc-200/80 px-1 py-3 text-sm text-zinc-600 transition-colors hover:text-teal-700 dark:border-zinc-800 dark:text-zinc-400 dark:hover:text-teal-300 lg:w-full"
            >
              <span class="font-semibold text-zinc-900 dark:text-zinc-100">{year}</span>
              <span>{poems.length} 首</span>
            </a>
          ))}
        </nav>
      </aside>

      <div>
        {groups.map(([year, poems]) => (
          <section id={`year-${year}`} class="scroll-mt-28 pb-14">
            <h2 class="mb-5 border-b border-zinc-200/80 pb-3 text-center font-serif-cn text-2xl font-semibold tracking-[0.08em] text-zinc-950 dark:border-zinc-800 dark:text-zinc-50 sm:text-left">
              {year}
            </h2>
            <div class="divide-y divide-zinc-200/80 dark:divide-zinc-800">
              {poems.map(poem => (
                <article class="grid gap-4 py-7 sm:grid-cols-[7rem_1fr]">
                  <time datetime={poem.data.pubDate.toISOString()} class="text-center text-xs uppercase tracking-[0.2em] text-zinc-500 dark:text-zinc-500 sm:text-left">
                    <FormattedDate date={poem.data.pubDate} />
                  </time>
                  <div class="text-center sm:text-left">
                    <h3 class="font-serif-cn text-2xl font-semibold text-zinc-950 dark:text-zinc-50">
                      <a href={`/poetry/${poem.slug}/`} class="transition-colors hover:text-teal-700 dark:hover:text-teal-300">
                        {poem.data.title}
                      </a>
                    </h3>
                    <p class="mx-auto mt-3 max-w-2xl line-clamp-2 text-sm leading-7 text-zinc-600 dark:text-zinc-400 sm:mx-0">
                      {excerptFor(poem)}
                    </p>
                  </div>
                </article>
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  (() => {
    const setupYearNavigation = () => {
      document.querySelectorAll('[data-year-nav] a[href^="#year-"]').forEach((link) => {
        if (!(link instanceof HTMLAnchorElement) || link.dataset.yearHandled === 'true') return;

        link.dataset.yearHandled = 'true';
        link.addEventListener('click', (event) => {
          const id = link.hash.slice(1);
          const target = id ? document.getElementById(id) : null;
          if (!target) return;

          event.preventDefault();
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          window.history.pushState(null, '', link.hash);
        });
      });

      if (window.location.hash.startsWith('#year-')) {
        const target = document.getElementById(window.location.hash.slice(1));
        if (target) {
          window.setTimeout(() => {
            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }, 80);
        }
      }
    };

    setupYearNavigation();
    document.addEventListener('DOMContentLoaded', setupYearNavigation);
    document.addEventListener('spa-content-loaded', setupYearNavigation);
  })();
</script>
