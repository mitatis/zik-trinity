---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { getEntryTags, isPublishedEntry, sortByPubDateDesc } from '../../utils/content';

export const prerender = true;

export async function getStaticPaths() {
  const allPosts = (await getCollection('blog')).filter(isPublishedEntry);
  const allJournalEntries = (await getCollection('journal')).filter(isPublishedEntry);
  const allTaggedEntries = [...allPosts, ...allJournalEntries];
  const uniqueTags = [...new Set(allTaggedEntries.flatMap(getEntryTags))];

  return uniqueTags.map(tag => {
    const filteredEntries = allTaggedEntries.filter(entry =>
      getEntryTags(entry).some(t => t.toLowerCase() === (tag as string).toLowerCase())
    );

    return {
      params: { tag },
      props: { entries: filteredEntries },
    };
  });
}

const { tag } = Astro.params as { tag: string };
const { entries = [] } = Astro.props;

const sortedEntries = entries.length > 0
  ? [...entries].filter(isPublishedEntry).sort(sortByPubDateDesc)
  : [];

const relatedTags = [...new Set(
  sortedEntries.flatMap(getEntryTags)
    .filter(t => t !== tag)
)].slice(0, 8);

const imageFor = (entry) => {
  const image = entry?.data?.heroImage || entry?.data?.image;
  if (!image) return '';
  if (typeof image === 'string') return image;
  if (typeof image === 'object' && 'src' in image) return image.src;
  return '';
};

const excerptFor = (entry) => {
  const source = entry?.data?.description || entry?.body || '';
  return source
    .replace(/<br\s*\/?>/gi, ' ')
    .replace(/[#*_>`-]/g, '')
    .replace(/\s+/g, ' ')
    .trim()
    .slice(0, 108);
};

const pathFor = (entry) => entry.collection === 'journal'
  ? `/journal/${entry.slug}/`
  : `/blog/${entry.slug}/`;
---

<BaseLayout title={`标签：${tag}`}>
  <section class="page-shell">
    <header class="page-hero">
      <a href="/tags" class="paper-link text-sm">返回标签</a>
      <h1 class="page-title mt-9">#{tag}</h1>
      <div class="mx-auto mt-5 h-px w-12 bg-teal-600 dark:bg-teal-300"></div>
      <p class="page-subtitle">
        当前有 {sortedEntries.length} 篇内容带有这个标签。
      </p>
    </header>

    {relatedTags.length > 0 && (
      <nav class="mx-auto mt-10 flex max-w-3xl flex-wrap justify-center gap-x-5 gap-y-3 border-b border-zinc-200/80 pb-8 text-sm dark:border-zinc-800" aria-label="相关标签">
        {relatedTags.map(relatedTag => (
          <a href={`/tags/${relatedTag}`} class="paper-link">#{relatedTag}</a>
        ))}
      </nav>
    )}

    {sortedEntries.length === 0 ? (
      <div class="mx-auto mt-14 max-w-2xl border-y border-zinc-200/80 py-10 text-center dark:border-zinc-800">
        <p class="font-serif-cn text-3xl font-semibold text-zinc-950 dark:text-zinc-50">没有内容</p>
        <p class="mx-auto mt-5 max-w-lg text-sm leading-8 text-zinc-600 dark:text-zinc-400">
          这个标签下暂时还没有公开内容。
        </p>
      </div>
    ) : (
      <div class="mx-auto mt-14 max-w-4xl border-t border-zinc-200/80 dark:border-zinc-800">
        {sortedEntries.map(entry => (
          <article class={`grid gap-5 border-b border-zinc-200/80 py-7 dark:border-zinc-800 ${imageFor(entry) ? 'sm:grid-cols-[8rem_1fr]' : 'sm:grid-cols-[7rem_1fr]'}`}>
            {imageFor(entry) ? (
              <a href={pathFor(entry)} class="overflow-hidden border border-zinc-200/80 bg-zinc-100 dark:border-zinc-800 dark:bg-zinc-900">
                <img src={imageFor(entry)} alt={entry.data.title} class="aspect-[4/3] w-full object-cover transition duration-500 hover:scale-[1.02]" loading="lazy" />
              </a>
            ) : (
              <time datetime={entry.data.pubDate.toISOString()} class="text-xs uppercase tracking-[0.2em] text-zinc-500 dark:text-zinc-500">
                <FormattedDate date={entry.data.pubDate} />
              </time>
            )}
            <div>
              {imageFor(entry) && (
                <time datetime={entry.data.pubDate.toISOString()} class="text-xs uppercase tracking-[0.2em] text-zinc-500 dark:text-zinc-500">
                  <FormattedDate date={entry.data.pubDate} />
                </time>
              )}
              <h2 class="mt-2 font-serif-cn text-2xl font-semibold text-zinc-950 dark:text-zinc-50">
                <a href={pathFor(entry)} class="transition-colors hover:text-teal-700 dark:hover:text-teal-300">
                  {entry.data.title}
                </a>
              </h2>
              <p class="mt-3 line-clamp-2 text-sm leading-7 text-zinc-600 dark:text-zinc-400">
                {excerptFor(entry)}
              </p>
            </div>
          </article>
        ))}
      </div>
    )}
  </section>
</BaseLayout>
