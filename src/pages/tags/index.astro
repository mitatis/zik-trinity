---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEntryTags, isPublishedEntry } from '../../utils/content';

const allPosts = (await getCollection('blog')).filter(isPublishedEntry);
const tags = [...new Set(allPosts.flatMap(getEntryTags))].sort();

const sortedTags = tags
  .map(tag => ({
    name: tag,
    count: allPosts.filter(post => getEntryTags(post).includes(tag)).length,
  }))
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name, 'zh-CN'));
---

<BaseLayout title="标签">
  <section class="page-shell">
    <header class="page-hero">
      <p class="font-serif-cn text-sm tracking-[0.28em] text-zinc-500 dark:text-zinc-500">索引与主题。</p>
      <h1 class="page-title mt-9">标签</h1>
      <div class="mx-auto mt-5 h-px w-12 bg-teal-600 dark:bg-teal-300"></div>
      <p class="page-subtitle">
        标签不是分类墙，只是回到某些主题的路标。
      </p>
    </header>

    {sortedTags.length === 0 ? (
      <div class="mx-auto mt-14 max-w-2xl border-y border-zinc-200/80 py-10 text-center dark:border-zinc-800">
        <p class="font-serif-cn text-3xl font-semibold text-zinc-950 dark:text-zinc-50">暂无标签</p>
        <p class="mx-auto mt-5 max-w-lg text-sm leading-8 text-zinc-600 dark:text-zinc-400">
          当博客文章同步进来后，标签会自动在这里生成。
        </p>
      </div>
    ) : (
      <div class="mx-auto mt-14 max-w-4xl border-t border-zinc-200/80 dark:border-zinc-800">
        {sortedTags.map(tag => (
          <a
            href={`/tags/${tag.name}`}
            class="group grid gap-4 border-b border-zinc-200/80 py-6 transition-colors hover:text-teal-700 dark:border-zinc-800 dark:hover:text-teal-300 sm:grid-cols-[1fr_6rem]"
          >
            <span>
              <span class="font-serif-cn text-3xl font-semibold tracking-[0.04em] text-zinc-950 transition-colors group-hover:text-teal-700 dark:text-zinc-50 dark:group-hover:text-teal-300">
                #{tag.name}
              </span>
            </span>
            <span class="text-left text-sm text-zinc-500 dark:text-zinc-500 sm:text-right">
              {tag.count} 篇
            </span>
          </a>
        ))}
      </div>
    )}
  </section>
</BaseLayout>
