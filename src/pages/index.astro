---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import WorkIcon from '../components/WorkIcon.astro';
import { getEntryDate, isDraftEntry, isPublishedEntry, sortByPubDateDesc } from '../utils/content';
import { dateToLocalKey, formatWorkDuration, getWorkMeta } from '../utils/work';

const allPosts = await getCollection('blog');
const allPoems = await getCollection('poetry');
const allJournalEntries = await getCollection('journal');

const posts = allPosts
  .filter(isPublishedEntry)
  .sort(sortByPubDateDesc);

const poems = allPoems
  .filter(isPublishedEntry)
  .sort(sortByPubDateDesc);

const recentPosts = posts.slice(0, 4);
const recentPoems = poems.slice(0, 4);
const visualEntries = [...posts, ...poems]
  .filter(entry => entry.data.heroImage || entry.data.image)
  .sort(sortByPubDateDesc)
  .slice(0, 3);

const todayKey = dateToLocalKey(new Date());
const workEntries = allJournalEntries
  .filter((entry) => !isDraftEntry(entry))
  .map((entry) => ({
    entry,
    entryDate: getEntryDate(entry),
    workMeta: getWorkMeta(entry),
  }))
  .filter(({ workMeta }) => Boolean(workMeta?.workStart || workMeta?.workEnd))
  .sort((a, b) => {
    const aTime = a.workMeta?.workEnd?.getTime() ?? a.workMeta?.workStart?.getTime() ?? a.entryDate?.getTime() ?? 0;
    const bTime = b.workMeta?.workEnd?.getTime() ?? b.workMeta?.workStart?.getTime() ?? b.entryDate?.getTime() ?? 0;
    return bTime - aTime;
  });

const activeWork = workEntries
  .filter(({ entryDate, workMeta }) => {
    if (!workMeta?.isActive || !workMeta.workStart) return false;

    const entryDateKey = entryDate ? dateToLocalKey(entryDate) : '';
    return entryDateKey === todayKey || dateToLocalKey(workMeta.workStart) === todayKey;
  })
  .sort((a, b) => (b.workMeta?.workStart?.getTime() ?? 0) - (a.workMeta?.workStart?.getTime() ?? 0))[0];
const latestWork = workEntries[0];
const homeWork = activeWork || latestWork;
const homeWorkState = activeWork ? 'active' : homeWork ? 'done' : '';
const homeWorkHref = homeWork ? `/journal/#journal-${homeWork.entry.slug}` : '';
const formatHomeWorkDate = (date?: Date | null) => date
  ? date.toLocaleDateString('zh', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : '';
const homeWorkDateLabel = homeWork
  ? formatHomeWorkDate(homeWork.entryDate ?? homeWork.workMeta?.workStart ?? homeWork.workMeta?.workEnd)
  : '';

const imageFor = (entry) => {
  const image = entry?.data?.heroImage || entry?.data?.image;
  if (!image) return '';
  if (typeof image === 'string') return image;
  if (typeof image === 'object' && 'src' in image) return image.src;
  return '';
};
const pathFor = (entry) => entry.collection === 'poetry' ? `/poetry/${entry.slug}` : `/blog/${entry.slug}`;

const excerptFor = (entry) => {
  const source = entry?.data?.description || entry?.body || '';
  return source
    .replace(/<br\s*\/?>/gi, ' ')
    .replace(/[#*_>`-]/g, '')
    .replace(/\s+/g, ' ')
    .trim()
    .slice(0, 72);
};
---

<Layout title="ZIK Trinity" description="见字如晤，这是 ZIK Trinity 的个人数字空间。">
  <section class="mx-auto w-full max-w-6xl px-4 pb-16 pt-8 sm:px-6 sm:pb-20 sm:pt-12">
    <div class="relative pb-16 text-center sm:pb-20">
      <p class="font-serif-cn text-sm tracking-[0.28em] text-zinc-500 dark:text-zinc-500">书写与哲思，记录与表达。</p>
      <h1 class="mt-10 font-serif-cn text-[clamp(3.5rem,9vw,7.5rem)] font-semibold leading-[1.04] tracking-[0.08em] text-zinc-950 dark:text-zinc-50">
        见字如晤
      </h1>
      <p class="mt-5 font-serif-cn text-xl tracking-[0.22em] text-zinc-900 dark:text-zinc-100 sm:text-2xl">ZIK Trinity</p>
      <div class="mx-auto mt-5 h-px w-12 bg-teal-600 dark:bg-teal-300"></div>
      <p class="mx-auto mt-9 max-w-xl text-sm leading-8 text-zinc-600 dark:text-zinc-400">
        这里收纳文章、散诗与一些仍在成形的念头。
      </p>
    </div>

    {homeWork?.workMeta && (
      <a
        href={homeWorkHref}
        class="group mx-auto -mt-6 block w-full max-w-2xl min-w-0 border-y border-zinc-200/80 py-5 text-left transition-colors hover:border-zinc-300/90 hover:bg-zinc-50/40 dark:border-zinc-800 dark:hover:border-zinc-700/80 dark:hover:bg-zinc-900/20"
        data-active-work-card
        data-work-state={homeWorkState}
        data-work-start={homeWork.workMeta.startIso}
      >
        <div class="flex min-w-0 flex-col gap-5 sm:flex-row sm:items-start sm:justify-between">
          <div class="min-w-0 flex-1">
            <p class="flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.2em] text-teal-700 dark:text-teal-300">
              <span class="h-2 w-2 rounded-full bg-teal-600 dark:bg-teal-300"></span>
              {homeWorkState === 'active' ? '正在工作中' : '下班了'}
            </p>
            <p class="mt-3 flex min-w-0 flex-wrap items-center gap-x-2 gap-y-1 text-sm leading-7 text-zinc-600 dark:text-zinc-400">
              <WorkIcon name="clock" tone="accent" />
              {homeWorkState === 'active' ? (
                <>
                  从 <span class="tabular-nums text-zinc-900 dark:text-zinc-100">{homeWork.workMeta.startTimeLabel}</span> 开始
                  {homeWork.workMeta.startPlaceLabel && <>，{homeWork.workMeta.startPlaceLabel}</>}
                </>
              ) : (
                <>
                  最近一次工作：
                  <span class="tabular-nums text-zinc-900 dark:text-zinc-100">
                    {homeWorkDateLabel}{homeWorkDateLabel && ' '}{homeWork.workMeta.timeRangeLabel}
                  </span>
                </>
              )}
            </p>
          </div>
          <div class="shrink-0 text-left sm:text-right">
            <p class="text-xs uppercase tracking-[0.18em] text-zinc-500 dark:text-zinc-500">
              {homeWorkState === 'active' ? 'Elapsed' : 'Duration'}
            </p>
            <p class="mt-2 font-serif-cn text-3xl font-semibold text-zinc-950 dark:text-zinc-50" data-active-work-timer={homeWorkState === 'active' ? 'true' : undefined}>
              {homeWorkState === 'active' && homeWork.workMeta.workStart
                ? formatWorkDuration(Date.now() - homeWork.workMeta.workStart.getTime())
                : homeWork.workMeta.durationLabel || '已完成'}
            </p>
          </div>
        </div>
      </a>
    )}
  </section>

  <section class="mx-auto w-full max-w-6xl px-4 pb-16 sm:px-6 sm:pb-20">
    <div class="grid border-y border-zinc-200/80 dark:border-zinc-800 md:grid-cols-2">
      <a href="/blog" class="group flex min-h-44 flex-col items-center justify-center px-8 py-10 text-center transition-colors hover:bg-white/60 dark:hover:bg-zinc-900/40 md:border-r md:border-zinc-200/80 md:dark:border-zinc-800">
        <h2 class="font-serif-cn text-3xl font-semibold tracking-[0.12em] text-zinc-950 dark:text-zinc-50">文章</h2>
        <p class="mt-5 max-w-sm text-sm leading-7 text-zinc-600 dark:text-zinc-400">关于文学、电影、思想和生活的随笔与评论。</p>
        <span class="mt-6 text-sm font-medium tracking-[0.12em] text-teal-700 transition-colors group-hover:text-teal-900 dark:text-teal-300 dark:group-hover:text-teal-100">进入文章 »</span>
      </a>

      <a href="/poetry" class="group flex min-h-44 flex-col items-center justify-center px-8 py-10 text-center transition-colors hover:bg-white/60 dark:hover:bg-zinc-900/40">
        <h2 class="font-serif-cn text-3xl font-semibold tracking-[0.12em] text-zinc-950 dark:text-zinc-50">散诗集</h2>
        <p class="mt-5 max-w-sm text-sm leading-7 text-zinc-600 dark:text-zinc-400">在语言的缝隙里，收集存在的剪影。</p>
        <span class="mt-6 text-sm font-medium tracking-[0.12em] text-teal-700 transition-colors group-hover:text-teal-900 dark:text-teal-300 dark:group-hover:text-teal-100">进入散诗集 »</span>
      </a>
    </div>
  </section>

  {visualEntries.length > 0 && (
    <section class="mx-auto w-full max-w-6xl px-4 pb-16 sm:px-6 sm:pb-20" aria-labelledby="visual-notes-title">
      <div class="mb-6 flex items-end justify-between gap-4 border-b border-zinc-200/80 pb-4 dark:border-zinc-800">
        <div>
          <p class="editorial-kicker">Visual Notes</p>
          <h2 id="visual-notes-title" class="mt-2 font-serif-cn text-2xl font-semibold tracking-[0.08em] text-zinc-950 dark:text-zinc-50">图像札记</h2>
        </div>
      </div>
      <div class="grid gap-4 md:grid-cols-3">
        {visualEntries.map(entry => (
          <a href={pathFor(entry)} class="group block">
            <figure class="overflow-hidden border border-zinc-200/80 bg-zinc-100 dark:border-zinc-800 dark:bg-zinc-900">
              <img
                src={imageFor(entry)}
                alt={entry.data.title}
                loading="lazy"
                class="aspect-[4/3] w-full object-cover transition duration-500 group-hover:scale-[1.02]"
              />
            </figure>
            <p class="mt-3 text-xs uppercase tracking-[0.18em] text-zinc-500 dark:text-zinc-500">
              <FormattedDate date={entry.data.pubDate} />
            </p>
            <h3 class="mt-2 font-serif-cn text-lg font-semibold text-zinc-950 transition-colors group-hover:text-teal-700 dark:text-zinc-50 dark:group-hover:text-teal-300">
              {entry.data.title}
            </h3>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="mx-auto w-full max-w-6xl px-4 pb-24 sm:px-6">
    <div class="mb-5 flex items-end justify-between gap-4">
      <h2 class="font-serif-cn text-xl font-semibold tracking-[0.12em] text-zinc-950 dark:text-zinc-50">最新文章</h2>
      <a href="/blog" class="text-sm text-zinc-500 transition-colors hover:text-teal-700 dark:text-zinc-400 dark:hover:text-teal-300">查看全部 ›</a>
    </div>

    <div class="border-y border-zinc-200/80 dark:border-zinc-800">
      {recentPosts.length > 0 ? (
        <div class="divide-y divide-zinc-200/80 dark:divide-zinc-800">
          {recentPosts.map(post => (
            <article class={`grid gap-5 py-4 ${imageFor(post) ? 'sm:grid-cols-[7rem_1fr]' : ''}`}>
              {imageFor(post) && (
                <a href={`/blog/${post.slug}`} class="block overflow-hidden border border-zinc-200 bg-zinc-100 dark:border-zinc-800 dark:bg-zinc-900">
                  <img src={imageFor(post)} alt={post.data.title} loading="lazy" class="aspect-[4/3] w-full object-cover transition duration-500 hover:scale-[1.02]" />
                </a>
              )}
              <a href={`/blog/${post.slug}`} class="group grid gap-4 sm:grid-cols-[7rem_1fr_auto] sm:items-baseline">
                <time datetime={post.data.pubDate.toISOString()} class="text-sm tabular-nums text-zinc-500 dark:text-zinc-500">
                  <FormattedDate date={post.data.pubDate} />
                </time>
                <div>
                  <h3 class="font-serif-cn text-lg font-semibold text-zinc-950 transition-colors group-hover:text-teal-700 dark:text-zinc-50 dark:group-hover:text-teal-300">
                    {post.data.title}
                  </h3>
                  <p class="mt-1 line-clamp-2 text-sm leading-6 text-zinc-600 dark:text-zinc-400">
                    {excerptFor(post) || '这篇文章正在整理摘要。'}
                  </p>
                </div>
                <span class="text-sm text-zinc-500 dark:text-zinc-500">{post.data.tags?.[0] || '随笔'}</span>
              </a>
            </article>
          ))}
        </div>
      ) : (
        <div class="grid gap-4 py-5 text-sm leading-7 text-zinc-600 dark:text-zinc-400 sm:grid-cols-[7rem_1fr_auto]">
          <span class="tabular-nums text-zinc-500 dark:text-zinc-500">-- --</span>
          <span class="font-serif-cn text-lg text-zinc-900 dark:text-zinc-100">文章正在整理</span>
          <span class="text-zinc-500 dark:text-zinc-500">书写中</span>
        </div>
      )}
    </div>

    <div class="mt-12 grid min-w-0 gap-12 lg:grid-cols-[minmax(0,0.88fr)_minmax(0,1.12fr)]">
      <section class="min-w-0" aria-labelledby="poem-list-title">
        <div class="mb-5 flex items-end justify-between gap-4">
          <h2 id="poem-list-title" class="font-serif-cn text-xl font-semibold tracking-[0.12em] text-zinc-950 dark:text-zinc-50">最近散诗</h2>
          <a href="/poetry" class="text-sm text-zinc-500 transition-colors hover:text-teal-700 dark:text-zinc-400 dark:hover:text-teal-300">查看全部 ›</a>
        </div>
        <div class="divide-y divide-zinc-200/80 border-y border-zinc-200/80 dark:divide-zinc-800 dark:border-zinc-800">
          {recentPoems.map(poem => (
            <a href={`/poetry/${poem.slug}`} class={`group grid min-w-0 gap-4 py-5 ${imageFor(poem) ? 'sm:grid-cols-[5.5rem_6.5rem_minmax(0,1fr)]' : 'sm:grid-cols-[5.5rem_minmax(0,1fr)]'}`}>
              <time datetime={poem.data.pubDate.toISOString()} class="min-w-0 text-sm tabular-nums text-zinc-500 dark:text-zinc-500">
                <FormattedDate date={poem.data.pubDate} />
              </time>
              {imageFor(poem) && (
                <span class="block overflow-hidden border border-zinc-200 bg-zinc-100 dark:border-zinc-800 dark:bg-zinc-900">
                  <img src={imageFor(poem)} alt={poem.data.title} loading="lazy" class="aspect-[4/3] w-full object-cover transition duration-500 group-hover:scale-[1.02]" />
                </span>
              )}
              <span class="min-w-0">
                <span class="block font-serif-cn text-lg font-semibold text-zinc-950 transition-colors group-hover:text-teal-700 dark:text-zinc-50 dark:group-hover:text-teal-300">{poem.data.title}</span>
                <span class="mt-1 line-clamp-1 block text-sm leading-6 text-zinc-600 dark:text-zinc-400">{excerptFor(poem)}</span>
              </span>
            </a>
          ))}
        </div>
      </section>

      <aside class="min-w-0">
        <div class="min-w-0 divide-y divide-zinc-200/80 border-y border-zinc-200/80 dark:divide-zinc-800 dark:border-zinc-800" data-presence-panel>
          <div class="min-w-0 py-5" data-presence-row="weread">
            <span class="text-xs font-semibold uppercase tracking-[0.18em] text-teal-700 dark:text-teal-300">WeRead</span>
            <span class="mt-2 block text-sm leading-6 text-zinc-600 dark:text-zinc-400" data-weread-detail>最近正在读的三本书会显示在这里。</span>
            <span class="mt-4 block space-y-3" data-weread-books></span>
          </div>

          <div class="min-w-0 py-5" data-presence-row="discord">
            <span class="flex flex-wrap items-baseline justify-between gap-3">
              <span class="text-xs font-semibold uppercase tracking-[0.18em] text-teal-700 dark:text-teal-300">Discord</span>
              <span class="text-sm tabular-nums text-zinc-500 dark:text-zinc-500" data-discord-status>Waiting</span>
            </span>
            <span class="mt-4 block" data-discord-card></span>
          </div>

          <div class="min-w-0 py-5" data-presence-row="steam">
            <span class="flex flex-wrap items-baseline justify-between gap-3">
              <span class="text-xs font-semibold uppercase tracking-[0.18em] text-teal-700 dark:text-teal-300">Steam</span>
              <span class="text-sm tabular-nums text-zinc-500 dark:text-zinc-500" data-steam-status>Waiting</span>
            </span>
            <span class="mt-4 block" data-steam-card></span>
            <span class="mt-5 flex items-center justify-between gap-3" data-steam-games-header hidden>
              <span class="block text-xs font-semibold uppercase tracking-[0.16em] text-zinc-500 dark:text-zinc-500" data-steam-games-label>最近玩过</span>
              <span class="flex items-center gap-1" data-steam-games-controls hidden>
                <button type="button" class="inline-flex h-8 w-8 items-center justify-center border border-zinc-200/80 bg-white/50 text-lg leading-none text-zinc-600 transition-colors hover:border-teal-600/50 hover:text-teal-700 disabled:cursor-not-allowed disabled:opacity-40 dark:border-zinc-800 dark:bg-zinc-950/30 dark:text-zinc-400 dark:hover:border-teal-300/50 dark:hover:text-teal-300" data-steam-games-scroll="prev" aria-label="向左滚动 Steam 最近游戏">‹</button>
                <button type="button" class="inline-flex h-8 w-8 items-center justify-center border border-zinc-200/80 bg-white/50 text-lg leading-none text-zinc-600 transition-colors hover:border-teal-600/50 hover:text-teal-700 disabled:cursor-not-allowed disabled:opacity-40 dark:border-zinc-800 dark:bg-zinc-950/30 dark:text-zinc-400 dark:hover:border-teal-300/50 dark:hover:text-teal-300" data-steam-games-scroll="next" aria-label="向右滚动 Steam 最近游戏">›</button>
              </span>
            </span>
            <span class="mt-3 flex w-full min-w-0 max-w-full gap-3 overflow-x-auto overscroll-x-contain scroll-smooth pb-1" data-steam-games></span>
          </div>
        </div>
      </aside>
    </div>
  </section>
</Layout>

<script>
  function setupActiveWorkTimer() {
    document.querySelectorAll('[data-active-work-card]').forEach((card) => {
      if (!(card instanceof HTMLElement) || card.dataset.activeWorkHandled === 'true') return;
      if (card.dataset.workState !== 'active') return;

      const timer = card.querySelector('[data-active-work-timer]');
      const start = new Date(card.dataset.workStart || '');
      if (!timer || Number.isNaN(start.getTime())) return;

      card.dataset.activeWorkHandled = 'true';

      const formatDuration = (milliseconds) => {
        const totalSeconds = Math.max(0, Math.floor(milliseconds / 1000));
        const hours = Math.floor(totalSeconds / 3600);
        const minutes = Math.floor((totalSeconds % 3600) / 60);
        const seconds = totalSeconds % 60;

        return [hours, minutes, seconds]
          .map((value) => String(value).padStart(2, '0'))
          .join(':');
      };

      const update = () => {
        timer.textContent = formatDuration(Date.now() - start.getTime());
      };

      update();
      const intervalId = window.setInterval(() => {
        if (!card.isConnected) {
          window.clearInterval(intervalId);
          return;
        }

        update();
      }, 1000);
    });
  }

  function setupPresencePanel() {
    const panel = document.querySelector('[data-presence-panel]');
    if (!(panel instanceof HTMLElement) || panel.dataset.presenceHandled === 'true') return;

    panel.dataset.presenceHandled = 'true';

    const discordStatus = panel.querySelector('[data-discord-status]');
    const discordCard = panel.querySelector('[data-discord-card]');
    const steamStatus = panel.querySelector('[data-steam-status]');
    const steamCard = panel.querySelector('[data-steam-card]');
    const steamGamesHeader = panel.querySelector('[data-steam-games-header]');
    const steamGamesLabel = panel.querySelector('[data-steam-games-label]');
    const steamGamesControls = panel.querySelector('[data-steam-games-controls]');
    const steamGamesPrev = panel.querySelector('[data-steam-games-scroll="prev"]');
    const steamGamesNext = panel.querySelector('[data-steam-games-scroll="next"]');
    const steamGames = panel.querySelector('[data-steam-games]');
    const wereadDetail = panel.querySelector('[data-weread-detail]');
    const wereadBooks = panel.querySelector('[data-weread-books]');

    const statusText = {
      online: 'Online',
      idle: 'Idle',
      dnd: 'DND',
      offline: 'Offline',
      unconfigured: 'Waiting',
      unknown: 'Unknown',
    };

    const steamStatusText = {
      online: 'Online',
      offline: 'Offline',
      away: 'Away',
      busy: 'Busy',
      snooze: 'Snooze',
      looking_to_trade: 'Trade',
      looking_to_play: 'Play',
      unconfigured: 'Waiting',
      unknown: 'Unknown',
    };

    const formatTime = (value) => {
      if (!value) return '';
      const date = new Date(value);
      if (Number.isNaN(date.getTime())) return '';

      return date.toLocaleString('zh', {
        month: 'numeric',
        day: 'numeric',
        hour: '2-digit',
        minute: '2-digit',
      });
    };

    const formatSeconds = (seconds) => {
      const totalMinutes = Math.max(0, Math.round(Number(seconds || 0) / 60));
      if (!totalMinutes) return '';

      const hours = Math.floor(totalMinutes / 60);
      const minutes = totalMinutes % 60;
      if (hours && minutes) return `${hours} 小时 ${minutes} 分钟`;
      if (hours) return `${hours} 小时`;
      return `${minutes} 分钟`;
    };

    const formatMinutes = (minutes) => {
      const totalMinutes = Math.max(0, Math.round(Number(minutes || 0)));
      if (!totalMinutes) return '';

      const hours = Math.floor(totalMinutes / 60);
      const restMinutes = totalMinutes % 60;
      if (hours && restMinutes) return `${hours}h${restMinutes}m`;
      if (hours) return `${hours}h`;
      return `${restMinutes}m`;
    };

    const setText = (element, value) => {
      if (element) element.textContent = value;
    };

    const setOptionalText = (element, value) => {
      if (!element) return;
      const text = value || '';
      element.textContent = text;
      element.hidden = !text;
    };

    const clearElement = (element) => {
      if (!element) return;
      while (element.firstChild) {
        element.firstChild.remove();
      }
    };

    const progressPercent = (value) => {
      const numberValue = Number(value);
      if (!Number.isFinite(numberValue)) return null;
      return Math.max(0, Math.min(100, Math.round(numberValue)));
    };

    const shouldShowSteamGameControls = () => (
      steamGames instanceof HTMLElement
      && window.matchMedia('(min-width: 768px)').matches
      && steamGames.scrollWidth > steamGames.clientWidth + 2
    );

    const updateSteamGameControls = () => {
      if (!(steamGames instanceof HTMLElement) || !(steamGamesControls instanceof HTMLElement)) return;

      const showControls = shouldShowSteamGameControls();
      steamGamesControls.hidden = !showControls;
      if (!showControls) return;

      const maxScrollLeft = Math.max(0, steamGames.scrollWidth - steamGames.clientWidth);
      const currentScrollLeft = Math.max(0, steamGames.scrollLeft);
      if (steamGamesPrev instanceof HTMLButtonElement) {
        steamGamesPrev.disabled = currentScrollLeft <= 2;
      }
      if (steamGamesNext instanceof HTMLButtonElement) {
        steamGamesNext.disabled = currentScrollLeft >= maxScrollLeft - 2;
      }
    };

    const scrollSteamGames = (direction) => {
      if (!(steamGames instanceof HTMLElement)) return;

      const scrollDistance = Math.max(160, Math.floor(steamGames.clientWidth * 0.86));
      steamGames.scrollBy({ left: direction * scrollDistance, behavior: 'smooth' });
      window.setTimeout(updateSteamGameControls, 260);
    };

    if (steamGamesPrev instanceof HTMLButtonElement) {
      steamGamesPrev.addEventListener('click', () => scrollSteamGames(-1));
    }
    if (steamGamesNext instanceof HTMLButtonElement) {
      steamGamesNext.addEventListener('click', () => scrollSteamGames(1));
    }
    if (steamGames instanceof HTMLElement) {
      steamGames.addEventListener('scroll', updateSteamGameControls, { passive: true });
    }
    window.addEventListener('resize', updateSteamGameControls);

    const renderDiscordCard = (discord) => {
      clearElement(discordCard);
      if (!discordCard) return;

      const card = document.createElement(discord?.kv?.url ? 'a' : 'span');
      if (discord?.kv?.url) {
        card.href = discord.kv.url;
        card.target = '_blank';
        card.rel = 'noopener noreferrer';
      }
      card.className = 'group block min-w-0 max-w-full border border-zinc-200/80 bg-white/40 p-3 transition duration-300 hover:-translate-y-0.5 hover:border-indigo-500/50 hover:bg-white/70 dark:border-zinc-800 dark:bg-zinc-950/30 dark:hover:border-indigo-400/50 dark:hover:bg-zinc-900/50';

      const header = document.createElement('span');
      header.className = 'flex min-w-0 items-center gap-3';

      const avatarWrap = document.createElement('span');
      avatarWrap.className = 'relative block h-14 w-14 shrink-0 overflow-hidden rounded-full border border-zinc-200 bg-zinc-100 dark:border-zinc-800 dark:bg-zinc-900';

      const avatarUrl = discord?.user?.avatarUrl || '';
      if (avatarUrl) {
        const avatar = document.createElement('img');
        avatar.src = avatarUrl;
        avatar.alt = `${discord.user.displayName || discord.user.username || 'Discord'} avatar`;
        avatar.loading = 'lazy';
        avatar.decoding = 'async';
        avatar.className = 'h-full w-full object-cover';
        avatarWrap.appendChild(avatar);
      } else {
        const fallback = document.createElement('span');
        fallback.className = 'flex h-full w-full items-center justify-center text-xs font-semibold text-zinc-500 dark:text-zinc-500';
        fallback.textContent = 'DC';
        avatarWrap.appendChild(fallback);
      }

      const dot = document.createElement('span');
      const isOnline = discord?.status && discord.status !== 'offline' && discord.status !== 'unconfigured';
      dot.className = isOnline
        ? 'absolute bottom-0 right-0 h-3 w-3 rounded-full border-2 border-white bg-emerald-500 dark:border-zinc-950'
        : 'absolute bottom-0 right-0 h-3 w-3 rounded-full border-2 border-white bg-zinc-500 dark:border-zinc-950';
      avatarWrap.appendChild(dot);
      header.appendChild(avatarWrap);

      const identity = document.createElement('span');
      identity.className = 'min-w-0 flex-1';

      const name = document.createElement('span');
      name.className = 'block truncate font-serif-cn text-lg font-semibold text-zinc-950 transition-colors group-hover:text-indigo-700 dark:text-zinc-50 dark:group-hover:text-indigo-300';
      name.textContent = discord?.user?.displayName || discord?.user?.username || 'Discord';
      identity.appendChild(name);

      const handle = document.createElement('span');
      handle.className = 'mt-1 block truncate text-sm text-zinc-600 dark:text-zinc-400';
      handle.textContent = discord?.user?.username
        ? `@${discord.user.username} · ${statusText[discord.status] || discord.status || 'Online'}`
        : `${statusText[discord?.status] || discord?.status || 'Waiting'} on Discord`;
      identity.appendChild(handle);

      header.appendChild(identity);
      card.appendChild(header);

      const activityLine = document.createElement('span');
      activityLine.className = 'mt-3 block border-t border-zinc-200/70 pt-3 text-sm leading-6 text-zinc-600 dark:border-zinc-800/80 dark:text-zinc-400';

      const activities = Array.isArray(discord?.activities) ? discord.activities : [];
      const spotify = discord?.spotify;
      const mainActivity = spotify
        ? { name: spotify.song, details: spotify.artist, state: spotify.album, type: 'Listening' }
        : activities.find((activity) => activity.type !== 'Custom') || activities[0];

      if (mainActivity) {
        const label = document.createElement('span');
        label.className = 'block truncate font-medium text-zinc-900 dark:text-zinc-100';
        label.textContent = `${mainActivity.type ? `${mainActivity.type} · ` : ''}${mainActivity.name || 'Discord 活动'}`;
        activityLine.appendChild(label);

        const detail = document.createElement('span');
        detail.className = 'mt-1 block truncate';
        detail.textContent = [mainActivity.details, mainActivity.state].filter(Boolean).join(' · ') || '正在公开活动中';
        activityLine.appendChild(detail);
      } else {
        activityLine.textContent = '当前没有公开活动。';
      }

      card.appendChild(activityLine);
      discordCard.appendChild(card);
    };

    const gameStoreUrl = (game) => game?.appId
      ? `https://store.steampowered.com/app/${encodeURIComponent(game.appId)}/`
      : 'https://steamcommunity.com/';

    const renderSteamCard = (steam) => {
      clearElement(steamCard);
      if (!steamCard) return;

      const card = document.createElement(steam?.profileUrl ? 'a' : 'span');
      if (steam?.profileUrl) {
        card.href = steam.profileUrl;
        card.target = '_blank';
        card.rel = 'noopener noreferrer';
      }

      card.className = 'group flex min-w-0 max-w-full items-center gap-3 border border-zinc-200/80 bg-white/40 p-3 transition duration-300 hover:-translate-y-0.5 hover:border-teal-600/50 hover:bg-white/70 dark:border-zinc-800 dark:bg-zinc-950/30 dark:hover:border-teal-300/50 dark:hover:bg-zinc-900/50';

      const avatarWrap = document.createElement('span');
      avatarWrap.className = 'relative block h-14 w-14 shrink-0 overflow-hidden border border-zinc-200 bg-zinc-100 dark:border-zinc-800 dark:bg-zinc-900';

      if (steam?.avatar) {
        const avatar = document.createElement('img');
        avatar.src = steam.avatar.replace(/^http:\/\//, 'https://');
        avatar.alt = `${steam.personaName || 'Steam'} avatar`;
        avatar.loading = 'lazy';
        avatar.decoding = 'async';
        avatar.className = 'h-full w-full object-cover';
        avatarWrap.appendChild(avatar);
      } else {
        const fallback = document.createElement('span');
        fallback.className = 'flex h-full w-full items-center justify-center text-xs font-semibold text-zinc-500 dark:text-zinc-500';
        fallback.textContent = 'ST';
        avatarWrap.appendChild(fallback);
      }

      const dot = document.createElement('span');
      dot.className = steam?.isInGame
        ? 'absolute bottom-1 right-1 h-2.5 w-2.5 rounded-full bg-teal-500 ring-2 ring-white dark:ring-zinc-950'
        : 'absolute bottom-1 right-1 h-2.5 w-2.5 rounded-full bg-zinc-400 ring-2 ring-white dark:ring-zinc-950';
      avatarWrap.appendChild(dot);
      card.appendChild(avatarWrap);

      const content = document.createElement('span');
      content.className = 'min-w-0 flex-1';

      const name = document.createElement('span');
      name.className = 'block truncate font-serif-cn text-lg font-semibold text-zinc-950 transition-colors group-hover:text-teal-700 dark:text-zinc-50 dark:group-hover:text-teal-300';
      name.textContent = steam?.personaName || 'Steam';
      content.appendChild(name);

      const state = document.createElement('span');
      state.className = steam?.isInGame
        ? 'mt-1 block truncate text-sm text-teal-700 dark:text-teal-300'
        : 'mt-1 block truncate text-sm text-zinc-600 dark:text-zinc-400';
      state.textContent = steam?.isInGame && steam?.game?.name
        ? `正在玩 ${steam.game.name}`
        : `${steamStatusText[steam?.status] || steam?.status || 'Online'} on Steam`;
      content.appendChild(state);

      const meta = document.createElement('span');
      meta.className = 'mt-1 block truncate text-xs text-zinc-500 dark:text-zinc-500';
      const achievement = steam?.achievementSummary;
      meta.textContent = achievement?.total ? `最近游戏成就 ${achievement.unlocked}/${achievement.total}` : 'Steam 社交状态';
      content.appendChild(meta);

      card.appendChild(content);
      steamCard.appendChild(card);
    };

    const renderSteamGames = (steam) => {
      clearElement(steamGames);
      if (!steamGames) return;

      const recentGames = Array.isArray(steam?.recentGames) ? steam.recentGames : [];
      setOptionalText(steamGamesLabel, recentGames.length ? '最近玩过' : '');
      if (steamGamesHeader instanceof HTMLElement) {
        steamGamesHeader.hidden = !recentGames.length;
      }
      if (!recentGames.length) {
        updateSteamGameControls();
        return;
      }

      const maxMinutes = Math.max(...recentGames.map((game) => game.playtime2WeeksMinutes || game.playtimeForeverMinutes || 0), 1);

      recentGames.forEach((game) => {
        const minutes = game.playtime2WeeksMinutes || game.playtimeForeverMinutes || 0;
        const ratio = Math.max(4, Math.min(100, Math.round((minutes / maxMinutes) * 100)));
        const row = document.createElement('a');
        row.href = gameStoreUrl(game);
        row.target = '_blank';
        row.rel = 'noopener noreferrer';
        row.className = 'group w-40 min-w-40 max-w-[72vw] shrink-0 overflow-hidden border border-zinc-200/80 bg-white/40 transition duration-300 hover:-translate-y-0.5 hover:border-teal-600/50 hover:bg-white/70 dark:border-zinc-800 dark:bg-zinc-950/30 dark:hover:border-teal-300/50 dark:hover:bg-zinc-900/50';

        const cover = document.createElement('span');
        cover.className = 'block h-16 w-full overflow-hidden bg-zinc-100 dark:bg-zinc-900';

        const image = document.createElement('img');
        image.src = game.headerUrl || game.iconUrl || '';
        image.alt = game.name ? `${game.name} Steam 封面` : 'Steam 游戏封面';
        image.loading = 'lazy';
        image.decoding = 'async';
        image.className = 'h-full w-full object-cover transition duration-300 group-hover:scale-105';
        image.onerror = () => {
          if (game.iconUrl && image.src !== game.iconUrl) {
            image.src = game.iconUrl;
            return;
          }
          image.hidden = true;
        };
        cover.appendChild(image);
        row.appendChild(cover);

        const content = document.createElement('span');
        content.className = 'block min-w-0 p-3';

        const name = document.createElement('span');
        name.className = 'block truncate font-serif-cn text-sm font-semibold text-zinc-950 transition-colors group-hover:text-teal-700 dark:text-zinc-50 dark:group-hover:text-teal-300';
        name.textContent = game.name || 'Steam 游戏';
        content.appendChild(name);

        const meta = document.createElement('span');
        meta.className = 'mt-1 block truncate text-xs text-zinc-600 dark:text-zinc-400';
        const recentMinutes = game.playtime2WeeksMinutes || game.playtimeForeverMinutes || 0;
        meta.textContent = `${game.playtime2WeeksMinutes ? '近两周' : '最近'} ${formatMinutes(recentMinutes)}${game.playtimeForeverMinutes ? ` · 总计 ${formatMinutes(game.playtimeForeverMinutes)}` : ''}`;
        content.appendChild(meta);

        const track = document.createElement('span');
        track.className = 'mt-2 block h-1 overflow-hidden bg-zinc-200 dark:bg-zinc-800';
        const bar = document.createElement('span');
        bar.className = 'block h-full bg-teal-600 dark:bg-teal-300';
        bar.style.width = `${ratio}%`;
        track.appendChild(bar);
        content.appendChild(track);

        row.appendChild(content);
        steamGames.appendChild(row);
      });

      window.requestAnimationFrame(updateSteamGameControls);
    };

    const renderWereadBooks = (books) => {
      clearElement(wereadBooks);
      if (!wereadBooks) return;

      books.forEach((book) => {
        const progress = progressPercent(book.progress);
        const row = document.createElement('span');
        row.className = 'grid min-w-0 grid-cols-[3rem_minmax(0,1fr)] gap-3 border-t border-zinc-200/70 pt-3 first:border-t-0 first:pt-0 dark:border-zinc-800/80';

        const cover = typeof book.cover === 'string' ? book.cover.replace(/^http:\/\//, 'https://') : '';
        if (cover) {
          const image = document.createElement('img');
          image.src = cover;
          image.alt = book.title || '微信读书书籍封面';
          image.loading = 'lazy';
          image.decoding = 'async';
          image.className = 'h-[4.25rem] w-12 border border-zinc-200 bg-zinc-100 object-cover dark:border-zinc-800 dark:bg-zinc-900';
          row.appendChild(image);
        } else {
          const fallback = document.createElement('span');
          fallback.className = 'flex h-[4.25rem] w-12 items-center justify-center border border-zinc-200 bg-zinc-100 font-serif-cn text-lg text-zinc-500 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-500';
          fallback.textContent = '书';
          row.appendChild(fallback);
        }

        const content = document.createElement('span');
        content.className = 'min-w-0 py-0.5';

        const title = document.createElement('span');
        title.className = 'block truncate font-serif-cn text-base font-semibold text-zinc-950 dark:text-zinc-50';
        title.textContent = book.title || '未命名书籍';
        content.appendChild(title);

        const meta = document.createElement('span');
        meta.className = 'mt-1 block truncate text-sm text-zinc-600 dark:text-zinc-400';
        meta.textContent = book.author || '作者未知';
        content.appendChild(meta);

        const progressWrap = document.createElement('span');
        progressWrap.className = 'mt-2 grid grid-cols-[1fr_auto] items-center gap-3';

        const track = document.createElement('span');
        track.className = 'h-1 overflow-hidden bg-zinc-200 dark:bg-zinc-800';
        const bar = document.createElement('span');
        bar.className = 'block h-full bg-teal-600 dark:bg-teal-300';
        bar.style.width = `${progress ?? 0}%`;
        track.appendChild(bar);
        progressWrap.appendChild(track);

        const label = document.createElement('span');
        label.className = 'text-xs tabular-nums text-zinc-500 dark:text-zinc-500';
        label.textContent = progress === null ? '暂无进度' : `${progress}%`;
        progressWrap.appendChild(label);
        content.appendChild(progressWrap);

        row.appendChild(content);
        wereadBooks.appendChild(row);
      });
    };

    const renderDiscord = (discord) => {
      if (!discord?.configured) {
        setText(discordStatus, 'Waiting');
        renderDiscordCard({
          status: 'unconfigured',
          user: {
            displayName: '等待连接 Discord',
            username: 'Lanyard',
          },
        });
        return;
      }
      setText(discordStatus, statusText[discord.status] || discord.status || 'Online');
      renderDiscordCard(discord);
    };

    const renderSteam = (steam) => {
      if (!steam?.configured) {
        setText(steamStatus, 'Waiting');
        renderSteamCard({
          personaName: '等待连接 Steam',
          status: 'unconfigured',
        });
        renderSteamGames(null);
        return;
      }

      if (steam.error) {
        setText(steamStatus, 'Error');
        renderSteamCard({
          personaName: 'Steam 状态暂不可用',
          status: 'unknown',
        });
        renderSteamGames(null);
        return;
      }

      const recentGames = Array.isArray(steam.recentGames) ? steam.recentGames : [];
      renderSteamCard(steam);
      renderSteamGames(steam);

      if (steam.isInGame && steam.game?.name) {
        setText(steamStatus, 'Playing');
        return;
      }

      if (recentGames.length) {
        setText(steamStatus, `${recentGames.length} 款`);
        return;
      }

      setText(steamStatus, steam.status || 'Online');
    };

    const renderWeread = (reading) => {
      if (!reading?.configured) {
        setOptionalText(wereadDetail, '配置 WEREAD_API_KEY 后显示最近正在读的三本书。');
        renderWereadBooks([]);
        return;
      }

      if (!Array.isArray(reading.books) || reading.books.length === 0) {
        setOptionalText(wereadDetail, reading.error ? '微信读书接口暂时没有返回书籍。' : '书架里还没有可展示的阅读进度。');
        renderWereadBooks([]);
        return;
      }

      const books = reading.books.slice(0, 3);
      const primary = books[0];
      const lastReadAt = formatTime(primary.lastReadAt);
      const duration = formatSeconds(reading.totalReadingTimeSeconds);
      const readingSummary = [
        lastReadAt ? `上次阅读：${lastReadAt}` : '上次阅读：暂无记录',
        duration ? `总累计 ${duration}` : '',
      ].filter(Boolean).join(' · ');

      setOptionalText(wereadDetail, readingSummary);
      renderWereadBooks(books);
    };

    const renderFallback = () => {
      renderDiscord(null);
      renderSteam(null);
      renderWeread(null);
    };

    const fetchPresence = async () => {
      try {
        const response = await fetch('/api/presence', {
          cache: 'no-store',
          headers: { accept: 'application/json' },
        });
        if (!response.ok) {
          renderFallback();
          return;
        }

        const payload = await response.json();
        renderDiscord(payload.discord);
        renderSteam(payload.steam);
        renderWeread(payload.reading);
      } catch {
        renderFallback();
      }
    };

    fetchPresence();
    window.setInterval(fetchPresence, 60 * 1000);
  }

  setupActiveWorkTimer();
  setupPresencePanel();
  document.addEventListener('DOMContentLoaded', setupActiveWorkTimer);
  document.addEventListener('DOMContentLoaded', setupPresencePanel);
  document.addEventListener('spa-content-loaded', setupActiveWorkTimer);
  document.addEventListener('spa-content-loaded', setupPresencePanel);
</script>
