---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import WorkIcon from '../components/WorkIcon.astro';
import { getEntryDate, isDraftEntry, isPublishedEntry, sortByPubDateDesc } from '../utils/content';
import { dateToLocalKey, formatWorkDuration, getWorkMeta } from '../utils/work';

const allPosts = await getCollection('blog');
const allPoems = await getCollection('poetry');
const allJournalEntries = await getCollection('journal');

const posts = allPosts
  .filter(isPublishedEntry)
  .sort(sortByPubDateDesc);

const poems = allPoems
  .filter(isPublishedEntry)
  .sort(sortByPubDateDesc);

const recentPosts = posts.slice(0, 4);
const recentPoems = poems.slice(0, 4);
const visualEntries = [...posts, ...poems]
  .filter(entry => entry.data.heroImage || entry.data.image)
  .sort(sortByPubDateDesc)
  .slice(0, 3);

const todayKey = dateToLocalKey(new Date());
const workEntries = allJournalEntries
  .filter((entry) => !isDraftEntry(entry))
  .map((entry) => ({
    entry,
    entryDate: getEntryDate(entry),
    workMeta: getWorkMeta(entry),
  }))
  .filter(({ workMeta }) => Boolean(workMeta?.workStart || workMeta?.workEnd))
  .sort((a, b) => {
    const aTime = a.workMeta?.workEnd?.getTime() ?? a.workMeta?.workStart?.getTime() ?? a.entryDate?.getTime() ?? 0;
    const bTime = b.workMeta?.workEnd?.getTime() ?? b.workMeta?.workStart?.getTime() ?? b.entryDate?.getTime() ?? 0;
    return bTime - aTime;
  });

const activeWork = workEntries
  .filter(({ entryDate, workMeta }) => {
    if (!workMeta?.isActive || !workMeta.workStart) return false;

    const entryDateKey = entryDate ? dateToLocalKey(entryDate) : '';
    return entryDateKey === todayKey || dateToLocalKey(workMeta.workStart) === todayKey;
  })
  .sort((a, b) => (b.workMeta?.workStart?.getTime() ?? 0) - (a.workMeta?.workStart?.getTime() ?? 0))[0];
const latestWork = workEntries[0];
const homeWork = activeWork || latestWork;
const homeWorkState = activeWork ? 'active' : homeWork ? 'done' : '';
const homeWorkHref = homeWork ? `/journal/#journal-${homeWork.entry.slug}` : '';
const formatHomeWorkDate = (date?: Date | null) => date
  ? date.toLocaleDateString('zh', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : '';
const homeWorkDateLabel = homeWork
  ? formatHomeWorkDate(homeWork.entryDate ?? homeWork.workMeta?.workStart ?? homeWork.workMeta?.workEnd)
  : '';

const imageFor = (entry) => {
  const image = entry?.data?.heroImage || entry?.data?.image;
  if (!image) return '';
  if (typeof image === 'string') return image;
  if (typeof image === 'object' && 'src' in image) return image.src;
  return '';
};
const pathFor = (entry) => entry.collection === 'poetry' ? `/poetry/${entry.slug}` : `/blog/${entry.slug}`;

const excerptFor = (entry) => {
  const source = entry?.data?.description || entry?.body || '';
  return source
    .replace(/<br\s*\/?>/gi, ' ')
    .replace(/[#*_>`-]/g, '')
    .replace(/\s+/g, ' ')
    .trim()
    .slice(0, 72);
};
---

<Layout title="ZIK Trinity" description="见字如晤，这是 ZIK Trinity 的个人数字空间。">
  <section class="mx-auto w-full max-w-6xl px-4 pb-16 pt-8 sm:px-6 sm:pb-20 sm:pt-12">
    <div class="relative pb-16 text-center sm:pb-20">
      <p class="font-serif-cn text-sm tracking-[0.28em] text-zinc-500 dark:text-zinc-500">书写与哲思，记录与表达。</p>
      <h1 class="mt-10 font-serif-cn text-[clamp(3.5rem,9vw,7.5rem)] font-semibold leading-[1.04] tracking-[0.08em] text-zinc-950 dark:text-zinc-50">
        见字如晤
      </h1>
      <p class="mt-5 font-serif-cn text-xl tracking-[0.22em] text-zinc-900 dark:text-zinc-100 sm:text-2xl">ZIK Trinity</p>
      <div class="mx-auto mt-5 h-px w-12 bg-teal-600 dark:bg-teal-300"></div>
      <p class="mx-auto mt-9 max-w-xl text-sm leading-8 text-zinc-600 dark:text-zinc-400">
        这里收纳文章、散诗与一些仍在成形的念头。
      </p>
    </div>

    {homeWork?.workMeta && (
      <a
        href={homeWorkHref}
        class="group mx-auto -mt-6 block max-w-2xl border-y border-zinc-200/80 py-5 text-left transition-colors hover:border-zinc-300/90 hover:bg-zinc-50/40 dark:border-zinc-800 dark:hover:border-zinc-700/80 dark:hover:bg-zinc-900/20"
        data-active-work-card
        data-work-state={homeWorkState}
        data-work-start={homeWork.workMeta.startIso}
      >
        <div class="flex flex-col gap-5 sm:flex-row sm:items-start sm:justify-between">
          <div class="min-w-0">
            <p class="flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.2em] text-teal-700 dark:text-teal-300">
              <span class="h-2 w-2 rounded-full bg-teal-600 dark:bg-teal-300"></span>
              {homeWorkState === 'active' ? '正在工作中' : '下班了'}
            </p>
            <p class="mt-3 flex min-w-0 flex-wrap items-center gap-x-2 gap-y-1 text-sm leading-7 text-zinc-600 dark:text-zinc-400">
              <WorkIcon name="clock" tone="accent" />
              {homeWorkState === 'active' ? (
                <>
                  从 <span class="tabular-nums text-zinc-900 dark:text-zinc-100">{homeWork.workMeta.startTimeLabel}</span> 开始
                  {homeWork.workMeta.startPlaceLabel && <>，{homeWork.workMeta.startPlaceLabel}</>}
                </>
              ) : (
                <>
                  最近一次工作：
                  <span class="tabular-nums text-zinc-900 dark:text-zinc-100">
                    {homeWorkDateLabel}{homeWorkDateLabel && ' '}{homeWork.workMeta.timeRangeLabel}
                  </span>
                </>
              )}
            </p>
          </div>
          <div class="shrink-0 text-left sm:text-right">
            <p class="text-xs uppercase tracking-[0.18em] text-zinc-500 dark:text-zinc-500">
              {homeWorkState === 'active' ? 'Elapsed' : 'Duration'}
            </p>
            <p class="mt-2 font-serif-cn text-3xl font-semibold text-zinc-950 dark:text-zinc-50" data-active-work-timer={homeWorkState === 'active' ? 'true' : undefined}>
              {homeWorkState === 'active' && homeWork.workMeta.workStart
                ? formatWorkDuration(Date.now() - homeWork.workMeta.workStart.getTime())
                : homeWork.workMeta.durationLabel || '已完成'}
            </p>
          </div>
        </div>
      </a>
    )}
  </section>

  <section class="mx-auto w-full max-w-6xl px-4 pb-16 sm:px-6 sm:pb-20">
    <div class="grid border-y border-zinc-200/80 dark:border-zinc-800 md:grid-cols-2">
      <a href="/blog" class="group flex min-h-44 flex-col items-center justify-center px-8 py-10 text-center transition-colors hover:bg-white/60 dark:hover:bg-zinc-900/40 md:border-r md:border-zinc-200/80 md:dark:border-zinc-800">
        <h2 class="font-serif-cn text-3xl font-semibold tracking-[0.12em] text-zinc-950 dark:text-zinc-50">文章</h2>
        <p class="mt-5 max-w-sm text-sm leading-7 text-zinc-600 dark:text-zinc-400">关于文学、电影、思想和生活的随笔与评论。</p>
        <span class="mt-6 text-sm font-medium tracking-[0.12em] text-teal-700 transition-colors group-hover:text-teal-900 dark:text-teal-300 dark:group-hover:text-teal-100">进入文章 »</span>
      </a>

      <a href="/poetry" class="group flex min-h-44 flex-col items-center justify-center px-8 py-10 text-center transition-colors hover:bg-white/60 dark:hover:bg-zinc-900/40">
        <h2 class="font-serif-cn text-3xl font-semibold tracking-[0.12em] text-zinc-950 dark:text-zinc-50">散诗集</h2>
        <p class="mt-5 max-w-sm text-sm leading-7 text-zinc-600 dark:text-zinc-400">在语言的缝隙里，收集存在的剪影。</p>
        <span class="mt-6 text-sm font-medium tracking-[0.12em] text-teal-700 transition-colors group-hover:text-teal-900 dark:text-teal-300 dark:group-hover:text-teal-100">进入散诗集 »</span>
      </a>
    </div>
  </section>

  {visualEntries.length > 0 && (
    <section class="mx-auto w-full max-w-6xl px-4 pb-16 sm:px-6 sm:pb-20" aria-labelledby="visual-notes-title">
      <div class="mb-6 flex items-end justify-between gap-4 border-b border-zinc-200/80 pb-4 dark:border-zinc-800">
        <div>
          <p class="editorial-kicker">Visual Notes</p>
          <h2 id="visual-notes-title" class="mt-2 font-serif-cn text-2xl font-semibold tracking-[0.08em] text-zinc-950 dark:text-zinc-50">图像札记</h2>
        </div>
      </div>
      <div class="grid gap-4 md:grid-cols-3">
        {visualEntries.map(entry => (
          <a href={pathFor(entry)} class="group block">
            <figure class="overflow-hidden border border-zinc-200/80 bg-zinc-100 dark:border-zinc-800 dark:bg-zinc-900">
              <img
                src={imageFor(entry)}
                alt={entry.data.title}
                loading="lazy"
                class="aspect-[4/3] w-full object-cover grayscale transition duration-500 group-hover:grayscale-0"
              />
            </figure>
            <p class="mt-3 text-xs uppercase tracking-[0.18em] text-zinc-500 dark:text-zinc-500">
              <FormattedDate date={entry.data.pubDate} />
            </p>
            <h3 class="mt-2 font-serif-cn text-lg font-semibold text-zinc-950 transition-colors group-hover:text-teal-700 dark:text-zinc-50 dark:group-hover:text-teal-300">
              {entry.data.title}
            </h3>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="mx-auto w-full max-w-6xl px-4 pb-24 sm:px-6">
    <div class="mb-5 flex items-end justify-between gap-4">
      <h2 class="font-serif-cn text-xl font-semibold tracking-[0.12em] text-zinc-950 dark:text-zinc-50">最新文章</h2>
      <a href="/blog" class="text-sm text-zinc-500 transition-colors hover:text-teal-700 dark:text-zinc-400 dark:hover:text-teal-300">查看全部 ›</a>
    </div>

    <div class="border-y border-zinc-200/80 dark:border-zinc-800">
      {recentPosts.length > 0 ? (
        <div class="divide-y divide-zinc-200/80 dark:divide-zinc-800">
          {recentPosts.map(post => (
            <article class={`grid gap-5 py-4 ${imageFor(post) ? 'sm:grid-cols-[7rem_1fr]' : ''}`}>
              {imageFor(post) && (
                <a href={`/blog/${post.slug}`} class="block overflow-hidden border border-zinc-200 bg-zinc-100 dark:border-zinc-800 dark:bg-zinc-900">
                  <img src={imageFor(post)} alt={post.data.title} loading="lazy" class="aspect-[4/3] w-full object-cover grayscale transition duration-500 hover:grayscale-0" />
                </a>
              )}
              <a href={`/blog/${post.slug}`} class="group grid gap-4 sm:grid-cols-[7rem_1fr_auto] sm:items-baseline">
                <time datetime={post.data.pubDate.toISOString()} class="text-sm tabular-nums text-zinc-500 dark:text-zinc-500">
                  <FormattedDate date={post.data.pubDate} />
                </time>
                <div>
                  <h3 class="font-serif-cn text-lg font-semibold text-zinc-950 transition-colors group-hover:text-teal-700 dark:text-zinc-50 dark:group-hover:text-teal-300">
                    {post.data.title}
                  </h3>
                  <p class="mt-1 line-clamp-2 text-sm leading-6 text-zinc-600 dark:text-zinc-400">
                    {excerptFor(post) || '这篇文章正在整理摘要。'}
                  </p>
                </div>
                <span class="text-sm text-zinc-500 dark:text-zinc-500">{post.data.tags?.[0] || '随笔'}</span>
              </a>
            </article>
          ))}
        </div>
      ) : (
        <div class="grid gap-4 py-5 text-sm leading-7 text-zinc-600 dark:text-zinc-400 sm:grid-cols-[7rem_1fr_auto]">
          <span class="tabular-nums text-zinc-500 dark:text-zinc-500">-- --</span>
          <span class="font-serif-cn text-lg text-zinc-900 dark:text-zinc-100">文章正在整理</span>
          <span class="text-zinc-500 dark:text-zinc-500">书写中</span>
        </div>
      )}
    </div>

    <div class="mt-12 grid gap-12 lg:grid-cols-[0.88fr_1.12fr]">
      <section aria-labelledby="poem-list-title">
        <div class="mb-5 flex items-end justify-between gap-4">
          <h2 id="poem-list-title" class="font-serif-cn text-xl font-semibold tracking-[0.12em] text-zinc-950 dark:text-zinc-50">最近散诗</h2>
          <a href="/poetry" class="text-sm text-zinc-500 transition-colors hover:text-teal-700 dark:text-zinc-400 dark:hover:text-teal-300">查看全部 ›</a>
        </div>
        <div class="divide-y divide-zinc-200/80 border-y border-zinc-200/80 dark:divide-zinc-800 dark:border-zinc-800">
          {recentPoems.map(poem => (
            <a href={`/poetry/${poem.slug}`} class={`group grid gap-4 py-5 ${imageFor(poem) ? 'sm:grid-cols-[5.5rem_6.5rem_1fr]' : 'sm:grid-cols-[5.5rem_1fr]'}`}>
              <time datetime={poem.data.pubDate.toISOString()} class="text-sm tabular-nums text-zinc-500 dark:text-zinc-500">
                <FormattedDate date={poem.data.pubDate} />
              </time>
              {imageFor(poem) && (
                <span class="block overflow-hidden border border-zinc-200 bg-zinc-100 dark:border-zinc-800 dark:bg-zinc-900">
                  <img src={imageFor(poem)} alt={poem.data.title} loading="lazy" class="aspect-[4/3] w-full object-cover grayscale transition duration-500 group-hover:grayscale-0" />
                </span>
              )}
              <span>
                <span class="block font-serif-cn text-lg font-semibold text-zinc-950 transition-colors group-hover:text-teal-700 dark:text-zinc-50 dark:group-hover:text-teal-300">{poem.data.title}</span>
                <span class="mt-1 line-clamp-1 block text-sm leading-6 text-zinc-600 dark:text-zinc-400">{excerptFor(poem)}</span>
              </span>
            </a>
          ))}
        </div>
      </section>

      <aside class="border-y border-zinc-200/80 py-8 dark:border-zinc-800">
        <p class="editorial-kicker">Editor's Note</p>
        <p class="mt-6 max-w-2xl font-serif-cn text-2xl leading-10 text-zinc-900 dark:text-zinc-100">
          我写作，是为了在意义的碎片中打捞秩序；在电影与书籍里，在现实与梦境中，寻找语言仍可能让与我相似的人停留片刻。
        </p>
        <div class="mt-7 h-px w-12 bg-teal-600 dark:bg-teal-300"></div>
        <div class="mt-8 divide-y divide-zinc-200/80 border-y border-zinc-200/80 dark:divide-zinc-800 dark:border-zinc-800" data-presence-panel>
          <a
            href="https://lanyard.rest/"
            target="_blank"
            rel="noopener noreferrer"
            class="group grid gap-3 py-5 transition-colors hover:bg-zinc-50/60 dark:hover:bg-zinc-900/30 sm:grid-cols-[8rem_1fr_auto]"
            data-presence-row="discord"
          >
            <span class="text-xs font-semibold uppercase tracking-[0.18em] text-teal-700 dark:text-teal-300">Discord</span>
            <span class="min-w-0">
              <span class="block font-serif-cn text-lg font-semibold text-zinc-950 dark:text-zinc-50" data-discord-title>连接 Lanyard 后显示当前活动</span>
              <span class="mt-1 line-clamp-2 block text-sm leading-6 text-zinc-600 dark:text-zinc-400" data-discord-detail>在线状态、游戏、Spotify 与所有公开活动会显示在这里。</span>
            </span>
            <span class="text-sm tabular-nums text-zinc-500 dark:text-zinc-500" data-discord-status>Waiting</span>
          </a>

          <div class="grid gap-3 py-5 sm:grid-cols-[8rem_1fr_auto]" data-presence-row="weread">
            <span class="text-xs font-semibold uppercase tracking-[0.18em] text-teal-700 dark:text-teal-300">WeRead</span>
            <span class="min-w-0">
              <span class="block font-serif-cn text-lg font-semibold text-zinc-950 dark:text-zinc-50" data-weread-title>连接微信读书后显示最近阅读</span>
              <span class="mt-1 line-clamp-2 block text-sm leading-6 text-zinc-600 dark:text-zinc-400" data-weread-detail>最近正在读的几本书名和进度会显示在这里。</span>
            </span>
            <span class="text-sm tabular-nums text-zinc-500 dark:text-zinc-500" data-weread-status>Waiting</span>
          </div>
        </div>
      </aside>
    </div>
  </section>
</Layout>

<script>
  function setupActiveWorkTimer() {
    document.querySelectorAll('[data-active-work-card]').forEach((card) => {
      if (!(card instanceof HTMLElement) || card.dataset.activeWorkHandled === 'true') return;
      if (card.dataset.workState !== 'active') return;

      const timer = card.querySelector('[data-active-work-timer]');
      const start = new Date(card.dataset.workStart || '');
      if (!timer || Number.isNaN(start.getTime())) return;

      card.dataset.activeWorkHandled = 'true';

      const formatDuration = (milliseconds) => {
        const totalSeconds = Math.max(0, Math.floor(milliseconds / 1000));
        const hours = Math.floor(totalSeconds / 3600);
        const minutes = Math.floor((totalSeconds % 3600) / 60);
        const seconds = totalSeconds % 60;

        return [hours, minutes, seconds]
          .map((value) => String(value).padStart(2, '0'))
          .join(':');
      };

      const update = () => {
        timer.textContent = formatDuration(Date.now() - start.getTime());
      };

      update();
      const intervalId = window.setInterval(() => {
        if (!card.isConnected) {
          window.clearInterval(intervalId);
          return;
        }

        update();
      }, 1000);
    });
  }

  function setupPresencePanel() {
    const panel = document.querySelector('[data-presence-panel]');
    if (!(panel instanceof HTMLElement) || panel.dataset.presenceHandled === 'true') return;

    panel.dataset.presenceHandled = 'true';

    const discordRow = panel.querySelector('[data-presence-row="discord"]');
    const discordTitle = panel.querySelector('[data-discord-title]');
    const discordDetail = panel.querySelector('[data-discord-detail]');
    const discordStatus = panel.querySelector('[data-discord-status]');
    const wereadTitle = panel.querySelector('[data-weread-title]');
    const wereadDetail = panel.querySelector('[data-weread-detail]');
    const wereadStatus = panel.querySelector('[data-weread-status]');

    const statusText = {
      online: 'Online',
      idle: 'Idle',
      dnd: 'DND',
      offline: 'Offline',
      unconfigured: 'Waiting',
      unknown: 'Unknown',
    };

    const formatTime = (value) => {
      if (!value) return '';
      const date = new Date(value);
      if (Number.isNaN(date.getTime())) return '';

      return date.toLocaleString('zh', {
        month: 'numeric',
        day: 'numeric',
        hour: '2-digit',
        minute: '2-digit',
      });
    };

    const formatSeconds = (seconds) => {
      const totalMinutes = Math.max(0, Math.round(Number(seconds || 0) / 60));
      if (!totalMinutes) return '';

      const hours = Math.floor(totalMinutes / 60);
      const minutes = totalMinutes % 60;
      if (hours && minutes) return `${hours} 小时 ${minutes} 分钟`;
      if (hours) return `${hours} 小时`;
      return `${minutes} 分钟`;
    };

    const setText = (element, value) => {
      if (element) element.textContent = value;
    };

    const renderDiscord = (discord) => {
      if (!discord?.configured) {
        setText(discordTitle, '等待连接 Lanyard');
        setText(discordDetail, '配置 LANYARD_USER_ID 后显示 Discord 当前活动。');
        setText(discordStatus, 'Waiting');
        return;
      }

      const activities = Array.isArray(discord.activities) ? discord.activities : [];
      const spotify = discord.spotify;
      const mainActivity = spotify
        ? { name: spotify.song, details: spotify.artist, type: 'Listening' }
        : activities.find((activity) => activity.type !== 'Custom') || activities[0];

      const title = mainActivity
        ? `${mainActivity.type ? `${mainActivity.type} · ` : ''}${mainActivity.name || 'Discord 活动'}`
        : `${statusText[discord.status] || discord.status || 'Online'} on Discord`;
      const detailParts = [];

      if (mainActivity?.details) detailParts.push(mainActivity.details);
      if (mainActivity?.state) detailParts.push(mainActivity.state);
      if (spotify?.album) detailParts.push(spotify.album);
      if (activities.length) {
        detailParts.push(activities.map((activity) => activity.name).filter(Boolean).slice(0, 4).join(' / '));
      }

      if (discordRow instanceof HTMLAnchorElement && discord.kv?.url) {
        discordRow.href = discord.kv.url;
      }

      setText(discordTitle, title);
      setText(discordDetail, detailParts.filter(Boolean).join(' · ') || '没有正在公开的活动。');
      setText(discordStatus, statusText[discord.status] || discord.status || 'Online');
    };

    const renderWeread = (reading) => {
      if (!reading?.configured) {
        setText(wereadTitle, '等待连接微信读书');
        setText(wereadDetail, '配置 WEREAD_API_KEY 后显示最近正在读的书。');
        setText(wereadStatus, 'Waiting');
        return;
      }

      if (!Array.isArray(reading.books) || reading.books.length === 0) {
        setText(wereadTitle, '最近阅读暂不可用');
        setText(wereadDetail, reading.error ? '微信读书接口暂时没有返回书籍。' : '书架里还没有可展示的阅读进度。');
        setText(wereadStatus, reading.error ? 'Error' : 'Empty');
        return;
      }

      const books = reading.books.slice(0, 3);
      const primary = books[0];
      const title = `${primary.title}${primary.progress !== null && primary.progress !== undefined ? ` · ${primary.progress}%` : ''}`;
      const detail = books
        .map((book) => {
          const parts = [book.title];
          if (book.progress !== null && book.progress !== undefined) parts.push(`${book.progress}%`);
          if (book.author) parts.push(book.author);
          return parts.join(' · ');
        })
        .join(' / ');
      const lastReadAt = formatTime(primary.lastReadAt);
      const duration = formatSeconds(primary.readingTimeSeconds);

      setText(wereadTitle, title);
      setText(wereadDetail, [detail, lastReadAt ? `上次阅读 ${lastReadAt}` : '', duration ? `累计 ${duration}` : ''].filter(Boolean).join(' · '));
      setText(wereadStatus, `${books.length} 本`);
    };

    const renderFallback = () => {
      renderDiscord(null);
      renderWeread(null);
    };

    const fetchPresence = async () => {
      try {
        const response = await fetch('/api/presence', {
          cache: 'no-store',
          headers: { accept: 'application/json' },
        });
        if (!response.ok) {
          renderFallback();
          return;
        }

        const payload = await response.json();
        renderDiscord(payload.discord);
        renderWeread(payload.reading);
      } catch {
        renderFallback();
      }
    };

    fetchPresence();
    window.setInterval(fetchPresence, 60 * 1000);
  }

  setupActiveWorkTimer();
  setupPresencePanel();
  document.addEventListener('DOMContentLoaded', setupActiveWorkTimer);
  document.addEventListener('DOMContentLoaded', setupPresencePanel);
  document.addEventListener('spa-content-loaded', setupActiveWorkTimer);
  document.addEventListener('spa-content-loaded', setupPresencePanel);
</script>
