---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import FormattedDate from '../components/FormattedDate.astro';

const allPosts = await getCollection('blog');
const allPoems = await getCollection('poetry');

const posts = allPosts
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const poems = allPoems
  .filter(poem => !poem.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const recentPosts = posts.slice(0, 4);
const recentPoems = poems.slice(0, 4);
const visualEntries = [...posts, ...poems]
  .filter(entry => entry.data.heroImage || entry.data.image)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

const imageFor = (entry) => {
  const image = entry?.data?.heroImage || entry?.data?.image;
  if (!image) return '';
  if (typeof image === 'string') return image;
  if (typeof image === 'object' && 'src' in image) return image.src;
  return '';
};
const pathFor = (entry) => entry.collection === 'poetry' ? `/poetry/${entry.slug}` : `/blog/${entry.slug}`;

const excerptFor = (entry) => {
  const source = entry?.data?.description || entry?.body || '';
  return source
    .replace(/<br\s*\/?>/gi, ' ')
    .replace(/[#*_>`-]/g, '')
    .replace(/\s+/g, ' ')
    .trim()
    .slice(0, 72);
};
---

<Layout title="ZIK Trinity" description="见字如晤，这是 ZIK Trinity 的个人数字空间。">
  <section class="mx-auto w-full max-w-6xl px-4 pb-16 pt-8 sm:px-6 sm:pb-20 sm:pt-12">
    <div class="relative pb-16 text-center sm:pb-20">
      <p class="font-serif-cn text-sm tracking-[0.28em] text-zinc-500 dark:text-zinc-500">书写与哲思，记录与表达。</p>
      <h1 class="mt-10 font-serif-cn text-[clamp(3.5rem,9vw,7.5rem)] font-semibold leading-[1.04] tracking-[0.08em] text-zinc-950 dark:text-zinc-50">
        见字如晤
      </h1>
      <p class="mt-5 font-serif-cn text-xl tracking-[0.22em] text-zinc-900 dark:text-zinc-100 sm:text-2xl">ZIK Trinity</p>
      <div class="mx-auto mt-5 h-px w-12 bg-teal-600 dark:bg-teal-300"></div>
      <p class="mx-auto mt-9 max-w-xl text-sm leading-8 text-zinc-600 dark:text-zinc-400">
        这里收纳文章、散诗与一些仍在成形的念头。
      </p>
    </div>
  </section>

  <section class="mx-auto w-full max-w-6xl px-4 pb-16 sm:px-6 sm:pb-20">
    <div class="grid border-y border-zinc-200/80 dark:border-zinc-800 md:grid-cols-2">
      <a href="/blog" class="group flex min-h-44 flex-col items-center justify-center px-8 py-10 text-center transition-colors hover:bg-white/60 dark:hover:bg-zinc-900/40 md:border-r md:border-zinc-200/80 md:dark:border-zinc-800">
        <h2 class="font-serif-cn text-3xl font-semibold tracking-[0.12em] text-zinc-950 dark:text-zinc-50">文章</h2>
        <p class="mt-5 max-w-sm text-sm leading-7 text-zinc-600 dark:text-zinc-400">关于文学、电影、思想和生活的随笔与评论。</p>
        <span class="mt-6 text-sm font-medium tracking-[0.12em] text-teal-700 transition-colors group-hover:text-teal-900 dark:text-teal-300 dark:group-hover:text-teal-100">进入文章 »</span>
      </a>

      <a href="/poetry" class="group flex min-h-44 flex-col items-center justify-center px-8 py-10 text-center transition-colors hover:bg-white/60 dark:hover:bg-zinc-900/40">
        <h2 class="font-serif-cn text-3xl font-semibold tracking-[0.12em] text-zinc-950 dark:text-zinc-50">散诗集</h2>
        <p class="mt-5 max-w-sm text-sm leading-7 text-zinc-600 dark:text-zinc-400">在语言的缝隙里，收集存在的剪影。</p>
        <span class="mt-6 text-sm font-medium tracking-[0.12em] text-teal-700 transition-colors group-hover:text-teal-900 dark:text-teal-300 dark:group-hover:text-teal-100">进入散诗集 »</span>
      </a>
    </div>
  </section>

  {visualEntries.length > 0 && (
    <section class="mx-auto w-full max-w-6xl px-4 pb-16 sm:px-6 sm:pb-20" aria-labelledby="visual-notes-title">
      <div class="mb-6 flex items-end justify-between gap-4 border-b border-zinc-200/80 pb-4 dark:border-zinc-800">
        <div>
          <p class="editorial-kicker">Visual Notes</p>
          <h2 id="visual-notes-title" class="mt-2 font-serif-cn text-2xl font-semibold tracking-[0.08em] text-zinc-950 dark:text-zinc-50">图像札记</h2>
        </div>
      </div>
      <div class="grid gap-4 md:grid-cols-3">
        {visualEntries.map(entry => (
          <a href={pathFor(entry)} class="group block">
            <figure class="overflow-hidden border border-zinc-200/80 bg-zinc-100 dark:border-zinc-800 dark:bg-zinc-900">
              <img
                src={imageFor(entry)}
                alt={entry.data.title}
                loading="lazy"
                class="aspect-[4/3] w-full object-cover grayscale transition duration-500 group-hover:grayscale-0"
              />
            </figure>
            <p class="mt-3 text-xs uppercase tracking-[0.18em] text-zinc-500 dark:text-zinc-500">
              <FormattedDate date={entry.data.pubDate} />
            </p>
            <h3 class="mt-2 font-serif-cn text-lg font-semibold text-zinc-950 transition-colors group-hover:text-teal-700 dark:text-zinc-50 dark:group-hover:text-teal-300">
              {entry.data.title}
            </h3>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="mx-auto w-full max-w-6xl px-4 pb-24 sm:px-6">
    <div class="mb-5 flex items-end justify-between gap-4">
      <h2 class="font-serif-cn text-xl font-semibold tracking-[0.12em] text-zinc-950 dark:text-zinc-50">最新文章</h2>
      <a href="/blog" class="text-sm text-zinc-500 transition-colors hover:text-teal-700 dark:text-zinc-400 dark:hover:text-teal-300">查看全部 ›</a>
    </div>

    <div class="border-y border-zinc-200/80 dark:border-zinc-800">
      {recentPosts.length > 0 ? (
        <div class="divide-y divide-zinc-200/80 dark:divide-zinc-800">
          {recentPosts.map(post => (
            <article class={`grid gap-5 py-4 ${imageFor(post) ? 'sm:grid-cols-[7rem_1fr]' : ''}`}>
              {imageFor(post) && (
                <a href={`/blog/${post.slug}`} class="block overflow-hidden border border-zinc-200 bg-zinc-100 dark:border-zinc-800 dark:bg-zinc-900">
                  <img src={imageFor(post)} alt={post.data.title} loading="lazy" class="aspect-[4/3] w-full object-cover grayscale transition duration-500 hover:grayscale-0" />
                </a>
              )}
              <a href={`/blog/${post.slug}`} class="group grid gap-4 sm:grid-cols-[7rem_1fr_auto] sm:items-baseline">
                <time datetime={post.data.pubDate.toISOString()} class="text-sm tabular-nums text-zinc-500 dark:text-zinc-500">
                  <FormattedDate date={post.data.pubDate} />
                </time>
                <div>
                  <h3 class="font-serif-cn text-lg font-semibold text-zinc-950 transition-colors group-hover:text-teal-700 dark:text-zinc-50 dark:group-hover:text-teal-300">
                    {post.data.title}
                  </h3>
                  <p class="mt-1 line-clamp-2 text-sm leading-6 text-zinc-600 dark:text-zinc-400">
                    {excerptFor(post) || '这篇文章正在整理摘要。'}
                  </p>
                </div>
                <span class="text-sm text-zinc-500 dark:text-zinc-500">{post.data.tags?.[0] || '随笔'}</span>
              </a>
            </article>
          ))}
        </div>
      ) : (
        <div class="grid gap-4 py-5 text-sm leading-7 text-zinc-600 dark:text-zinc-400 sm:grid-cols-[7rem_1fr_auto]">
          <span class="tabular-nums text-zinc-500 dark:text-zinc-500">-- --</span>
          <span class="font-serif-cn text-lg text-zinc-900 dark:text-zinc-100">文章正在整理</span>
          <span class="text-zinc-500 dark:text-zinc-500">书写中</span>
        </div>
      )}
    </div>

    <div class="mt-12 grid gap-12 lg:grid-cols-[0.88fr_1.12fr]">
      <section aria-labelledby="poem-list-title">
        <div class="mb-5 flex items-end justify-between gap-4">
          <h2 id="poem-list-title" class="font-serif-cn text-xl font-semibold tracking-[0.12em] text-zinc-950 dark:text-zinc-50">最近散诗</h2>
          <a href="/poetry" class="text-sm text-zinc-500 transition-colors hover:text-teal-700 dark:text-zinc-400 dark:hover:text-teal-300">查看全部 ›</a>
        </div>
        <div class="divide-y divide-zinc-200/80 border-y border-zinc-200/80 dark:divide-zinc-800 dark:border-zinc-800">
          {recentPoems.map(poem => (
            <a href={`/poetry/${poem.slug}`} class={`group grid gap-4 py-5 ${imageFor(poem) ? 'sm:grid-cols-[5.5rem_6.5rem_1fr]' : 'sm:grid-cols-[5.5rem_1fr]'}`}>
              <time datetime={poem.data.pubDate.toISOString()} class="text-sm tabular-nums text-zinc-500 dark:text-zinc-500">
                <FormattedDate date={poem.data.pubDate} />
              </time>
              {imageFor(poem) && (
                <span class="block overflow-hidden border border-zinc-200 bg-zinc-100 dark:border-zinc-800 dark:bg-zinc-900">
                  <img src={imageFor(poem)} alt={poem.data.title} loading="lazy" class="aspect-[4/3] w-full object-cover grayscale transition duration-500 group-hover:grayscale-0" />
                </span>
              )}
              <span>
                <span class="block font-serif-cn text-lg font-semibold text-zinc-950 transition-colors group-hover:text-teal-700 dark:text-zinc-50 dark:group-hover:text-teal-300">{poem.data.title}</span>
                <span class="mt-1 line-clamp-1 block text-sm leading-6 text-zinc-600 dark:text-zinc-400">{excerptFor(poem)}</span>
              </span>
            </a>
          ))}
        </div>
      </section>

      <aside class="border-y border-zinc-200/80 py-8 dark:border-zinc-800">
        <p class="editorial-kicker">Editor's Note</p>
        <p class="mt-6 max-w-2xl font-serif-cn text-2xl leading-10 text-zinc-900 dark:text-zinc-100">
          我写作，是为了在意义的碎片中打捞秩序；在电影与书籍里，在现实与梦境中，寻找语言仍可能让与我相似的人停留片刻。
        </p>
        <div class="mt-7 h-px w-12 bg-teal-600 dark:bg-teal-300"></div>
      </aside>
    </div>
  </section>
</Layout>
