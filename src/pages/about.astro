---
import BaseLayout from '../layouts/BaseLayout.astro';

const navLinks = [
  { text: 'Whisky', href: '/building' },
  { text: 'AI-Lab', href: 'https://lab.zik-3.com' },
];

const jobs = [
  {
    name: '零界星辰',
    sec: '',
    city: '杭州',
    nation: '中国',
    url: '',
    beginDate: '2026',
    endDate: '',
    icon: '',
    darkIcon: '',
    role: 'CEO',
  },
  {
    name: '宝洁',
    sec: 'CBD',
    city: '湖北',
    nation: '中国',
    url: 'https://www.pg.com.cn/',
    beginDate: '2025',
    endDate: '2026',
    icon: '/logos/P_G_Logo_RGB.svg',
    darkIcon: '',
    role: '',
  },
  {
    name: '莫斯科国立大学',
    sec: '商学院',
    city: '莫斯科',
    nation: '俄罗斯',
    url: 'https://msu.ru/',
    beginDate: '2022',
    endDate: '2025',
    icon: '/logos/MSU.png',
    darkIcon: '/logos/MSU_dark.png',
    role: '创新学',
  },
  {
    name: '莫斯科国立大学',
    sec: '物理学院',
    city: '莫斯科',
    nation: '俄罗斯',
    url: 'https://msu.ru/',
    beginDate: '2019',
    endDate: '2022',
    icon: '/logos/MSU.png',
    darkIcon: '/logos/MSU_dark.png',
    role: '',
  },
];
---

<BaseLayout title="关于" description="ZIK Trinity 的个人简介">
  <section class="page-shell">
    <header class="page-hero">
      <p class="font-serif-cn text-sm tracking-[0.28em] text-zinc-500 dark:text-zinc-500">“赠岁月以赞歌，予繁星以长眠。”</p>
      <h1 class="page-title mt-9">关于</h1>
      <div class="mx-auto mt-5 h-px w-12 bg-teal-600 dark:bg-teal-300"></div>
      <p class="page-subtitle">
        来自湖北武汉，曾在莫斯科生活过七年——正在寻找新的旅程。
      </p>
    </header>

    <div class="grid gap-12 border-b border-zinc-200/80 py-14 dark:border-zinc-800 lg:grid-cols-[0.82fr_1fr] lg:items-start">
      <figure class="mx-auto w-full max-w-sm overflow-hidden border border-zinc-200/80 bg-zinc-100 dark:border-zinc-800 dark:bg-zinc-900 lg:mx-0">
        <img
          src="https://s3.bmp.ovh/imgs/2025/06/02/8437953ff2cfe944.jpg"
          alt="Mitatis"
          class="aspect-[4/5] w-full object-cover"
          loading="eager"
        />
      </figure>

      <div class="space-y-10">
        <section>
          <h2 class="font-serif-cn text-3xl font-semibold tracking-[0.08em] text-zinc-950 dark:text-zinc-50">写作</h2>
          <div class="mt-6 space-y-5 text-sm leading-8 text-zinc-600 dark:text-zinc-400 sm:text-base">
            <p>
              我会在这里写一些主观性的，基于个人真实经历而创作的文字。它们可能关于文学、电影、诗歌，也可能只是某个阶段的生活切片。
            </p>
            <p>
              我受存在主义影响，在文学上钟爱陀翁与现代主义。因此这类作品，和其他主张主观感受、描述个人内心世界的相关著作，对我的生活与写作影响颇深。
            </p>
            <p>
              和多数人不同，我对诗歌的理解源于电影《死亡诗社》。在和片中相仿的学生时代，我经由电影里对诗歌的再解读认识了这一载体，并在这之后尝试以模仿为主的创作。
            </p>
            <p>
              真正属于自我的诗歌表达同样由第七艺术启蒙：从《雕刻时光》到《潜行者》、《索拉里斯星》。导演 安德烈·塔可夫斯基 用视听语言塑造了我对诗意世界的认知。
            </p>
          </div>
        </section>
      </div>
    </div>

    <section class="mx-auto max-w-4xl pt-14" aria-labelledby="journey-title">
      <div class="mb-8 text-center">
        <p class="editorial-kicker">Journey</p>
        <h2 id="journey-title" class="mt-3 font-serif-cn text-4xl font-semibold tracking-[0.08em] text-zinc-950 dark:text-zinc-50">在路上</h2>
      </div>

      <div class="border-t border-zinc-200/80 dark:border-zinc-800">
        {jobs.map(job => (
          <article class="grid gap-4 border-b border-zinc-200/80 py-7 dark:border-zinc-800 sm:grid-cols-[7rem_4rem_1fr_7rem] sm:items-center">
            <div class="text-sm tabular-nums text-zinc-500 dark:text-zinc-500">
              {job.endDate ? (
                <span>{job.endDate} / {job.beginDate}</span>
              ) : (
                <span>{job.beginDate}</span>
              )}
            </div>

            <a
              href={job.url || undefined}
              target={job.url ? '_blank' : undefined}
              rel={job.url ? 'noopener noreferrer' : undefined}
              class="flex h-12 w-12 items-center justify-center"
              aria-label={job.name}
            >
              {job.icon ? (
                <>
                  <img src={job.icon} alt={job.name} class="block h-full w-full object-contain dark:hidden" />
                  <img src={job.darkIcon || job.icon} alt={job.name} class="hidden h-full w-full object-contain dark:block" />
                </>
              ) : (
                <span class="flex h-11 w-11 items-center justify-center rounded-full border border-zinc-300 font-serif-cn text-base font-semibold text-zinc-700 dark:border-zinc-700 dark:text-zinc-200">
                  {job.name.slice(0, 1)}
                </span>
              )}
            </a>

            <div>
              <h3 class="font-serif-cn text-xl font-semibold text-zinc-950 dark:text-zinc-50">{job.name}</h3>
              <p class="mt-1 text-sm leading-6 text-zinc-600 dark:text-zinc-400">
                {[job.sec, job.role].filter(Boolean).join(' · ')}
              </p>
            </div>

            <p class="text-left text-sm font-medium text-zinc-700 dark:text-zinc-300 sm:text-right">
              {job.city}
            </p>
          </article>
        ))}
      </div>
    </section>
  </section>
</BaseLayout>
