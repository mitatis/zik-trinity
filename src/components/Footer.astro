---
const currentYear = new Date().getFullYear();

const socialLinks = [
  {
    name: 'GitHub',
    href: 'https://github.com/mitatis',
    icon: `<path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"></path>`,
  },
  {
    name: 'LinkedIn',
    href: 'https://www.linkedin.com/in/zikai-ai-43a22a36a/',
    icon: `<path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"></path>`,
  },
];
---

<footer class="mt-16 border-t border-zinc-200/80 dark:border-zinc-800">
  <div class="mx-auto w-full max-w-6xl px-4 py-7 sm:px-6">
    <section class="grid grid-cols-[1fr_auto] items-stretch gap-6 border-y border-zinc-200/80 py-7 dark:border-zinc-800 sm:gap-10">
      <div class="flex h-full flex-col items-start justify-between">
        <a href="/" class="inline-flex items-center" aria-label="ZIK Trinity">
          <img src="/favicon.svg" class="h-8 w-8 dark:invert" alt="ZIK Logo" />
        </a>
        <div class="mt-6">
          <div class="h-px w-10 bg-teal-600 dark:bg-teal-300"></div>
          <div class="mt-4 flex items-center gap-3">
            {socialLinks.map(social => (
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                class="flex h-10 w-10 items-center justify-center border border-zinc-200 text-zinc-500 transition-colors hover:border-teal-600 hover:text-teal-700 dark:border-zinc-800 dark:text-zinc-400 dark:hover:border-teal-400 dark:hover:text-teal-300"
                aria-label={social.name}
              >
                <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <Fragment set:html={social.icon} />
                </svg>
              </a>
            ))}
          </div>
        </div>
      </div>

      <div class="flex h-full flex-col items-end justify-between text-right">
        <a
          href="https://letterbird.co/mitatis"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-11 items-center justify-center gap-2 rounded-lg bg-zinc-950 px-5 py-2.5 text-sm font-semibold tracking-[0.08em] text-white shadow-sm transition-colors hover:bg-teal-700 dark:bg-zinc-50 dark:text-zinc-950 dark:hover:bg-teal-200 sm:px-6"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect width="20" height="16" x="2" y="4" rx="2"></rect>
            <path d="m22 7-8.97 5.7a2 2 0 0 1-2.06 0L2 7"></path>
          </svg>
          Say Hi
        </a>
        <p class="text-sm leading-7 text-zinc-600 dark:text-zinc-400">+86 132-6472-0888</p>
      </div>
    </section>

    <div class="flex items-center justify-between gap-4 pt-3 text-[0.68rem] uppercase tracking-[0.16em] text-zinc-500 dark:text-zinc-500">
      <p>&copy; {currentYear} ZIK Trinity</p>
      <a
        href="https://astro.build"
        target="_blank"
        rel="noopener noreferrer"
        class="w-fit transition-colors hover:text-teal-700 dark:hover:text-teal-300"
      >
        Powered by Astro
      </a>
    </div>
  </div>
</footer>
